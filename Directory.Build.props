<Project>

  <!--
    Общие свойства Linux-проектов. Настройки компилятора не повторяются, а
    берутся из Windows-репозитория: Nullable, предупреждения как ошибки,
    уровень анализа и языки ресурсов должны совпадать с общим кодом, иначе
    правка, чистая под одним файлом, ломала бы сборку под другим.

    Проекты из shared/ этот файл не видят: MSBuild берёт ближайший
    Directory.Build.props вверх по дереву, а для них это shared/Directory.Build.props.
    Так и должно быть — общий код собирается одинаково в обоих репозиториях.
  -->
  <Import Project="$(MSBuildThisFileDirectory)shared/Directory.Build.props" />

  <!--
    Версия у Linux своя: выпуски разных ОС выходят в разное время, а Spark
    показывает их раздельно. Импорт выше принёс версию Windows — здесь она
    перекрывается. Меняется релизным скриптом, руками не трогать.

    Из какого общего кода собран выпуск, говорит указатель подмодуля; при
    запуске он пишется в журнал рядом с версией.
  -->
  <PropertyGroup>
    <Version>0.1.1</Version>
  </PropertyGroup>

</Project>
