# Обновляльщик EliteSIP: ставит выпуск, на который согласился оператор, от
# root. Роль задачи планировщика от SYSTEM на Windows (W12, W-L7). Будят
# его elitesip-updater.timer раз в десять минут и elitesip-updater.path на
# отметку о согласии; аргументов у службы нет — выбирать ей нечего.
#
# Ставится пакетом в /usr/lib/systemd/system/. Разбор — src/EliteSIP.Updater.Linux.

[Unit]
Description=EliteSIP — установка обновлений
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/elitesip/elitesip-updater

# Свой каталог: журнал, копии отметок, проверенный пакет. 0700 — оператор
# сюда не пишет и не смотрит; родитель /var/lib/elitesip — root и 0755.
StateDirectory=elitesip/updater
StateDirectoryMode=0700
UMask=0077

# Такт — секунды, закачка пакета — минуты на плохом канале конторы (у
# клиента канала тот же срок, четверть часа). Сама установка идёт отдельной
# временной службой и сюда не входит. Дольше — значит висит.
TimeoutStartSec=20min

# Замок одной копии (src/EliteSIP.Updater.Linux/Layout.cs). Свой каталог в
# /run, а не файл в самом /run: при ProtectSystem=strict /run только для
# чтения, а этот каталог systemd открывает на запись сам.
RuntimeDirectory=elitesip-updater
RuntimeDirectoryMode=0700

# --- Изоляция -------------------------------------------------------------------
#
# Служба работает от root и разбирает то, что пришло по сети и из каталога,
# открытого всем на запись. Ошибка в разборе не должна давать root на всю
# машину, поэтому оставлено ровно то, что нужно такту:
#
#   - читать /opt/elitesip (ключ линии) и /var/lib/elitesip/updates (отметки,
#     скачанный пакет) — ProtectSystem=strict оставляет чтение;
#   - писать только свой StateDirectory (и RuntimeDirectory) — их systemd
#     открывает на запись сам;
#   - сеть (HTTPS к каналу) и сокеты systemd в /run: systemctl, systemd-run и
#     loginctl ходят к PID 1 и logind по шине. Подключение к сокету
#     ProtectSystem не мешает;
#   - подъём софтфона (systemctl --user -M <пользователь>@) идёт через
#     systemd-run во временной службе от имени пользователя — вне этой
#     изоляции; домашние каталоги службе нужны разве что для чтения;
#   - сама установка (apt-get, postinst) — отдельная временная служба
#     elitesip-install (Machine.cs) и этой изоляции не наследует: пакету нужно
#     писать в /opt, /etc и /usr.
#
# Чего здесь нет и почему: MemoryDenyWriteExecute — JIT .NET пишет
# исполняемый код; CapabilityBoundingSet — root читает отметки оператора и
# зовёт systemctl, и урезать возможности без проверки на живой машине значит
# рисковать единственным путём обновления (план, «Риски»).
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
