<Solution>
  <!--
    Общие проекты берутся из подмодуля shared/ (Windows-репозиторий) и здесь
    не правятся: правка общего кода идёт в Win-EliteSIP, а сюда приезжает
    сдвигом указателя подмодуля (docs/PORT-PLAN.md, «Правила работы с
    подмодулем»).

    В решение входят только проекты net10.0. Audio, Lines, App и Updater пока
    собираются под net10.0-windows и попадут сюда после разделения на этапе
    W-L1.
  -->
  <Folder Name="/shared/src/">
    <Project Path="shared/src/EliteSIP.AdminAccess/EliteSIP.AdminAccess.csproj" />
    <Project Path="shared/src/EliteSIP.CallGuard/EliteSIP.CallGuard.csproj" />
    <Project Path="shared/src/EliteSIP.CallHistory/EliteSIP.CallHistory.csproj" />
    <Project Path="shared/src/EliteSIP.Diagnostics/EliteSIP.Diagnostics.csproj" />
    <Project Path="shared/src/EliteSIP.MediaCore/EliteSIP.MediaCore.csproj" />
    <Project Path="shared/src/EliteSIP.PanelLink/EliteSIP.PanelLink.csproj" />
    <Project Path="shared/src/EliteSIP.SipCore.Udp/EliteSIP.SipCore.Udp.csproj" />
    <Project Path="shared/src/EliteSIP.SipCore/EliteSIP.SipCore.csproj" />
  </Folder>
  <Folder Name="/shared/tests/">
    <Project Path="shared/tests/EliteSIP.AdminAccess.Tests/EliteSIP.AdminAccess.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.CallGuard.Tests/EliteSIP.CallGuard.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.CallHistory.Tests/EliteSIP.CallHistory.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.Diagnostics.Tests/EliteSIP.Diagnostics.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.MediaCore.Tests/EliteSIP.MediaCore.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.PanelLink.Tests/EliteSIP.PanelLink.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.SipCore.Tests/EliteSIP.SipCore.Tests.csproj" />
  </Folder>
  <Folder Name="/shared/tools/">
    <Project Path="shared/tools/ReleaseKit/ReleaseKit.csproj" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/EliteSIP.Audio.Pulse/EliteSIP.Audio.Pulse.csproj" />
  </Folder>
  <Folder Name="/tests/" />
  <Folder Name="/tools/">
    <Project Path="tools/PulseProbe/PulseProbe.csproj" />
  </Folder>
</Solution>
