<Solution>
  <!--
    Общие проекты берутся из подмодуля shared/ (Windows-репозиторий) и здесь
    не правятся: правка общего кода идёт в Win-EliteSIP, а сюда приезжает
    сдвигом указателя подмодуля (docs/PORT-PLAN.md, «Правила работы с
    подмодулем»).

    В решение входят только проекты net10.0. Audio, Lines и App.Core — с ветки
    W-L1 (linux/w-l1-storage): на ней подмодуль стоит, пока эта ветка не
    выпущена меткой в Windows-репозитории. Lines нужен стенду W-L3
    (tools/SipCheck), App.Core — оболочке W-L4 (интерфейсы платформы).
    Updates добавится после выпуска W-L1, вместе со сдвигом указателя на метку.
  -->
  <Folder Name="/shared/src/">
    <Project Path="shared/src/EliteSIP.AdminAccess/EliteSIP.AdminAccess.csproj" />
    <Project Path="shared/src/EliteSIP.App.Core/EliteSIP.App.Core.csproj" />
    <Project Path="shared/src/EliteSIP.Audio/EliteSIP.Audio.csproj" />
    <Project Path="shared/src/EliteSIP.Audio.Signals/EliteSIP.Audio.Signals.csproj" />
    <Project Path="shared/src/EliteSIP.CallGuard/EliteSIP.CallGuard.csproj" />
    <Project Path="shared/src/EliteSIP.CallHistory/EliteSIP.CallHistory.csproj" />
    <Project Path="shared/src/EliteSIP.Diagnostics/EliteSIP.Diagnostics.csproj" />
    <Project Path="shared/src/EliteSIP.Lines/EliteSIP.Lines.csproj" />
    <Project Path="shared/src/EliteSIP.MediaCore/EliteSIP.MediaCore.csproj" />
    <Project Path="shared/src/EliteSIP.PanelLink/EliteSIP.PanelLink.csproj" />
    <Project Path="shared/src/EliteSIP.SipCore.Udp/EliteSIP.SipCore.Udp.csproj" />
    <Project Path="shared/src/EliteSIP.SipCore/EliteSIP.SipCore.csproj" />
  </Folder>
  <Folder Name="/shared/tests/">
    <Project Path="shared/tests/EliteSIP.AdminAccess.Tests/EliteSIP.AdminAccess.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.App.Core.Tests/EliteSIP.App.Core.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.Audio.Signals.Tests/EliteSIP.Audio.Signals.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.Audio.Tests/EliteSIP.Audio.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.CallGuard.Tests/EliteSIP.CallGuard.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.CallHistory.Tests/EliteSIP.CallHistory.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.Diagnostics.Tests/EliteSIP.Diagnostics.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.MediaCore.Tests/EliteSIP.MediaCore.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.PanelLink.Tests/EliteSIP.PanelLink.Tests.csproj" />
    <Project Path="shared/tests/EliteSIP.SipCore.Tests/EliteSIP.SipCore.Tests.csproj" />
  </Folder>
  <Folder Name="/shared/tools/">
    <Project Path="shared/tools/ReleaseKit/ReleaseKit.csproj" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/EliteSIP.App.Linux/EliteSIP.App.Linux.csproj" />
    <Project Path="src/EliteSIP.Audio.Pulse/EliteSIP.Audio.Pulse.csproj" />
    <Project Path="src/EliteSIP.Platform.Linux/EliteSIP.Platform.Linux.csproj" />
    <Project Path="src/EliteSIP.Updater.Linux/EliteSIP.Updater.Linux.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/EliteSIP.App.Linux.Tests/EliteSIP.App.Linux.Tests.csproj" />
    <Project Path="tests/EliteSIP.Audio.Pulse.Tests/EliteSIP.Audio.Pulse.Tests.csproj" />
    <Project Path="tests/EliteSIP.Platform.Linux.Tests/EliteSIP.Platform.Linux.Tests.csproj" />
    <Project Path="tests/EliteSIP.Updater.Linux.Tests/EliteSIP.Updater.Linux.Tests.csproj" />
  </Folder>
  <Folder Name="/tools/">
    <Project Path="tools/PulseProbe/PulseProbe.csproj" />
    <Project Path="tools/ShellProbe/ShellProbe.csproj" />
    <Project Path="tools/SipCheck/SipCheck.csproj" />
    <Project Path="tools/WindowProbe/WindowProbe.csproj" />
  </Folder>
</Solution>
