<!--
    Окно входящего — перевод исторический Windows EliteSIP.App/Incoming/IncomingCallWindow.xaml:
    320 в ширину, высота по содержимому, без рамки, поверх всех, без
    активации и без кнопки в панели задач. Проверка цифрой (W9) — те же
    кнопки, что на Windows.

    Цели приёма нажимаются только мышью. Focusable="False" — как на Windows;
    клавиатуры у окна и так нет (WM_HINTS.input = False). GuardedButton — аналог
    IsOffscreenBehavior: в Avalonia 12 на Linux есть мост AT-SPI, и видимую ему
    кнопку можно нажать действием «click» вообще без мыши, не пройдя ни одной
    проверки живого человека. «Отклонить» доступность сохраняет — отказаться
    от вызова можно и без мыши.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="using:EliteSIP.App.Theme"
        xmlns:incoming="using:EliteSIP.App.Incoming"
        xmlns:res="using:EliteSIP.App.Resources"
        x:Class="EliteSIP.App.Incoming.IncomingCallWindow"
        x:DataType="incoming:IncomingCallViewModel"
        Title="{res:Loc IncomingWindowTitle}"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowDecorations="None"
        WindowStartupLocation="Manual">

  <Border Name="IncomingFrame" CornerRadius="0" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
    <StackPanel Margin="12,8,12,12">
      <!--
          Шапка — ручка переноса: за неё карточку можно отодвинуть, не принимая
          и не отклоняя вызов. Кнопки приёма ниже переноса не начинают.
      -->
      <DockPanel x:Name="Header"
                 LastChildFill="False"
                 Background="Transparent"
                 Cursor="SizeAll">
        <theme:Icon DockPanel.Dock="Left"
                    Glyph="phone.arrow.down.left.fill"
                    Size="16"
                    VerticalAlignment="Center"
                    Classes.withdrawn="{Binding IsWithdrawn}" Classes="incoming-icon" />
        <TextBlock DockPanel.Dock="Left"
                   Margin="6,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Text="{Binding Caption}"
                   Classes="caption"
                   Classes.refused="{Binding IsRefused}" />
        <theme:Icon DockPanel.Dock="Right"
                    Glyph="lock.shield.fill"
                    Size="14"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextTertiaryBrush}"
                    AutomationProperties.Name="{res:Loc IncomingGuardOn}"
                    IsVisible="{Binding IsGuarded}" />
      </DockPanel>

      <!--
          Имя и номер — щелчком копируют номер. Только видимый: номер под
          маской не копируется (IncomingCallSubject.CopyableNumber).
      -->
      <Border Name="IdentityCard" Classes.withdrawn="{Binding IsWithdrawn}" Background="{DynamicResource CallFieldBrush}" CornerRadius="10" BoxShadow="0 3 9 0 #29000000" Padding="12,16" MinHeight="116" Margin="0,8,0,0">
          <StackPanel x:Name="NumberBlock" VerticalAlignment="Center"
                    Margin="0"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    Classes.copyable="{Binding CanCopyNumber}"
                    ToolTip.Tip="{res:Loc IncomingCopyNumber}"
                    ToolTip.IsEnabled="{Binding CanCopyNumber}">
          <TextBlock theme:Emoji.Text="{Binding Headline}" TextWrapping="Wrap" MaxWidth="312"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextTrimming="None"
                     FontSize="25"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding SecondaryNumber}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     FontSize="16"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     IsVisible="{Binding SecondaryNumber, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{res:Loc IncomingDealPrompt}"
                     Margin="0,5,0,0" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="#FFD782" IsVisible="{Binding IsSelfCall}" />
        </StackPanel>
      </Border>
      <Grid Margin="0,10,0,0">
        <StackPanel Classes.withdrawn="{Binding IsWithdrawn}" Classes="incoming-actions"
                    IsEnabled="{Binding !IsWithdrawn}">
          <!-- С выбором: «нажмите N» и ряд цифр, отбой ниже. -->
          <StackPanel IsVisible="{Binding HasChoice}">
            <Border Background="#29292E" CornerRadius="8" Padding="8,4" Margin="0,0,0,6">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="{res:Loc IncomingDigitPrompt}"
                           FontSize="15"
                           Foreground="#F4F4F5" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Answer}"
                           Foreground="#FFD782"
                           FontSize="25"
                           FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Targets}" Margin="-3,0,-3,6">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <incoming:GuardedButton Classes="surface digit-target"
                          Margin="3,0"
                          Height="56"
                          HorizontalAlignment="Stretch"
                          FontSize="25"
                          Content="{Binding}"
                          Command="{Binding $parent[Window].((incoming:IncomingCallViewModel)DataContext).AttemptCommand}"
                          CommandParameter="{Binding}"
                          Focusable="False" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="surface call hangup"
                    Height="50"
                    HorizontalAlignment="Stretch"
                    Command="{Binding DeclineCommand}"
                    AutomationProperties.Name="{res:Loc IncomingDecline}">
              <StackPanel Orientation="Horizontal">
                <theme:Icon Glyph="phone.down.fill" Size="14"
                            Foreground="White"
                            VerticalAlignment="Center" />
                <TextBlock Text="{res:Loc IncomingDecline}"
                           Margin="6,0,0,0"
                           FontSize="16"
                           Foreground="White" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Без выбора: «Ответить» и «Отклонить» рядом. -->
          <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding !HasChoice}">
            <incoming:GuardedButton Grid.Column="0"
                    Classes="surface call"
                    Height="50"
                    HorizontalAlignment="Stretch"
                    Command="{Binding AttemptCommand}"
                    CommandParameter="{Binding Answer}"
                    Focusable="False">
              <StackPanel Orientation="Horizontal">
                <theme:Icon Glyph="phone.fill" Size="14" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text="{res:Loc IncomingAnswer}" Margin="6,0,0,0" FontSize="16" Foreground="White" />
              </StackPanel>
            </incoming:GuardedButton>
            <Button Grid.Column="2"
                    Classes="surface call hangup"
                    Height="50"
                    HorizontalAlignment="Stretch"
                    Command="{Binding DeclineCommand}"
                    AutomationProperties.Name="{res:Loc IncomingDecline}">
              <StackPanel Orientation="Horizontal">
                <theme:Icon Glyph="phone.down.fill" Size="14" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text="{res:Loc IncomingDecline}" Margin="6,0,0,0" FontSize="16" Foreground="White" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
        <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="8" Padding="10"
                IsVisible="{Binding IsWithdrawn}">
          <TextBlock Text="{res:Loc IncomingWithdrawnNotice}" Foreground="{DynamicResource TextPrimaryBrush}"
                     TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
    </StackPanel>
  </Border>

  <Window.Styles>
    <Style Selector="theme|Icon.incoming-icon">
      <Setter Property="Foreground" Value="{DynamicResource OutcomeAnsweredBrush}" />
    </Style>
    <Style Selector="theme|Icon.incoming-icon.withdrawn">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="Border.withdrawn">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="StackPanel.incoming-actions.withdrawn">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="incoming|GuardedButton.digit-target">
      <Setter Property="Background" Value="#29292E" />
      <Setter Property="Foreground" Value="#F4F4F5" />
    </Style>
    <Style Selector="StackPanel.copyable">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.caption.refused">
      <Setter Property="Foreground" Value="{DynamicResource DeclineBrush}" />
    </Style>
  </Window.Styles>
</Window>
