<!--
    Стили элементов — перевод shared/src/EliteSIP.App/Theme/Controls.xaml.
    Почему каждое число такое, сказано там; здесь только как оно выражено в
    Avalonia: стиль с ключом стал классом (SurfaceButtonStyle → Button.surface),
    триггер — псевдоклассом (:pointerover, :pressed, :checked, :disabled).

    Основа — SimpleTheme: её шаблоны для полей, списков и меню годятся, если
    перекрасить кисти темы в палитру продукта (ниже, Resources). Свои шаблоны —
    только у кнопок панели: у них своя форма, и простая тема её не даёт.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="using:EliteSIP.App.Theme">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EliteSIP.App.Linux/Theme/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <x:Double x:Key="DisabledOpacity">0.57</x:Double>
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- Текст окна: кисть и кегль по умолчанию — те же, что у WPF-окон. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!--
      MARK: Рамка окна

      Рамку рисует Avalonia (Program.DrawsOwnFrame), а кнопки у неё по
      умолчанию как в Windows: прямоугольники 45 × 30, красный «закрыть».
      Здесь они переделаны под тему окон Cinnamon (Mint-Y,
      /usr/share/themes/Mint-Y/metacity-1): значки 16 × 16 — те же контуры,
      что в теме; круг 18 точек под значком — у «свернуть» и «развернуть»
      только при наведении, у «закрыть» всегда, цвета акцента рабочего стола
      (selected_bg_color темы — тот же цвет, что отдаёт портал), с белым
      крестом; у неактивного окна круг серый. Классы restore и inactive
      ставит DrawnCaption.

      Кнопки «во весь экран» у рамки Cinnamon нет, и софтфону она не нужна.
  -->
  <Style Selector=":is(Control)#PART_FullScreenButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="StackPanel#PART_OverlayPanel > Button">
    <Setter Property="Width" Value="26" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!--
            Fill и IsVisible кругов — стилями ниже, а не здесь: значение из
            шаблона у Avalonia сильнее стиля, и наведение, нажатие и цвет
            «закрыть» его бы не перекрыли.
        -->
        <Panel Background="Transparent">
          <Ellipse Name="Circle" Width="18" Height="18" />
          <Ellipse Name="Shade" Width="18" Height="18" />
          <Path Name="Glyph"
                Width="16" Height="16"
                Stretch="None"
                Fill="{TemplateBinding Foreground}"
                Data="{TemplateBinding Tag}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="StackPanel#PART_OverlayPanel > Button /template/ Ellipse#Circle">
    <Setter Property="Fill" Value="Transparent" />
  </Style>

  <Style Selector="StackPanel#PART_OverlayPanel > Button /template/ Ellipse#Shade">
    <Setter Property="Fill" Value="#33000000" />
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="StackPanel#PART_OverlayPanel > Button:pointerover /template/ Ellipse#Circle">
    <Setter Property="Fill" Value="{DynamicResource ControlHoverBrush}" />
  </Style>

  <Style Selector="StackPanel#PART_OverlayPanel > Button:pressed /template/ Ellipse#Circle">
    <Setter Property="Fill" Value="{DynamicResource ControlPressedBrush}" />
  </Style>

  <Style Selector="StackPanel#PART_OverlayPanel > Button#PART_MinimizeButton">
    <Setter Property="Tag">
      <StreamGeometry>M4 10v1h8v-1z</StreamGeometry>
    </Setter>
  </Style>

  <Style Selector="StackPanel#PART_OverlayPanel > Button#PART_MaximizeButton">
    <Setter Property="Tag">
      <StreamGeometry>M4 4v8h8V4zm1 1h6v6H5z</StreamGeometry>
    </Setter>
  </Style>

  <Style Selector="StackPanel#PART_OverlayPanel > Button#PART_MaximizeButton.restore">
    <Setter Property="Tag">
      <StreamGeometry>M3 5v8h8V5zm1 1h6v6H4zM5 3v1h7v7h1V3z</StreamGeometry>
    </Setter>
  </Style>

  <Style Selector="StackPanel#PART_OverlayPanel > Button#PART_CloseButton">
    <Setter Property="Foreground" Value="#F8F8F8" />
    <Setter Property="Tag">
      <StreamGeometry>M4.795 3.912l-.883.883.147.146L7.117 8 4.06 11.059l-.147.146.883.883.146-.147L8 8.883l3.059 3.058.146.147.883-.883-.147-.146L8.883 8l3.058-3.059.147-.146-.883-.883-.146.147L8 7.117 4.941 4.06z</StreamGeometry>
    </Setter>
  </Style>

  <Style Selector="StackPanel#PART_OverlayPanel > Button#PART_CloseButton /template/ Ellipse#Circle">
    <Setter Property="Fill" Value="{DynamicResource AccentFillBrush}" />
  </Style>

  <Style Selector="StackPanel#PART_OverlayPanel > Button#PART_CloseButton:pointerover /template/ Ellipse#Circle">
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="StackPanel#PART_OverlayPanel > Button#PART_CloseButton:pressed /template/ Ellipse#Shade">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="StackPanel#PART_OverlayPanel > Button#PART_CloseButton.inactive /template/ Ellipse#Circle">
    <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>

  <Style Selector="theme|Icon">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- MARK: Кнопки -->

  <!-- SurfaceButtonStyle: плашка цвета поверхности управления. -->
  <Style Selector="Button.surface">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Surface"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!--
      Имя PART_ContentPresenter — то же, что у SimpleTheme, и её стили
      наведения и нажатия Button красят презентер серым: под «Завершить»
      после отбоя (курсор так и стоит над кнопкой) оставалась серая плашка.
      Фон кнопки — у Border#Surface, у презентера его нет.
  -->
  <Style Selector="Button.surface /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.surface:pointerover /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
  </Style>
  <Style Selector="Button.surface:pressed /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
  </Style>
  <Style Selector="Button.surface:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.surface:disabled">
    <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
  </Style>
  <Style Selector="Button.surface:disabled /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
  </Style>

  <!-- ChromeButtonStyle: значок на прозрачном фоне, 22 × 22. -->
  <Style Selector="Button.surface.chrome">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Height" Value="22" />
  </Style>

  <!-- ProfilePillStyle: капсула профиля — 22 в высоту, скругление 11. -->
  <Style Selector="Button.surface.pill">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.surface.pill:disabled">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- AccentButtonStyle: синяя кнопка под белой надписью. -->
  <Style Selector="Button.surface.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.surface.accent:pointerover /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.surface.accent:pressed /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.surface.accent:disabled /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!--
      CallButtonStyle: «Позвонить» зелёная, «Положить трубку» (.hangup)
      красная. Наведение и нажатие — прозрачностью, а не другой заливкой: цвет
      здесь и есть смысл кнопки.
  -->
  <Style Selector="Button.surface.call">
    <Setter Property="Background" Value="{DynamicResource AnswerFillBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.surface.call.hangup">
    <Setter Property="Background" Value="{DynamicResource DeclineFillBrush}" />
  </Style>
  <Style Selector="Button.surface.call:pointerover /template/ Border#Surface">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.surface.call:pressed /template/ Border#Surface">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.surface.call:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.surface.call:disabled /template/ Border#Surface">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
  </Style>

  <!--
      ControlKeyStyle: клавиши «Удержание», «Микрофон», «Перевести»,
      «Конференция». Нажатая — оранжевая; «Микрофон выкл.» (.warning) — красная.
  -->
  <Style Selector="ToggleButton.key">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Surface"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource ControlCornerRadius}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!--
      Шаблон клавиши свой, но имя PART_ContentPresenter — то же, что у
      SimpleTheme, и её стиль нажатого ToggleButton красит этот презентер
      серым (ThemeControlHighBrush): на красной «Микрофон выкл.» под текстом
      была серая плашка. Фон клавиши — у Border#Surface, у презентера его нет.
  -->
  <Style Selector="ToggleButton.key /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.key:pointerover /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
  </Style>
  <Style Selector="ToggleButton.key:pressed /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
  </Style>
  <Style Selector="ToggleButton.key:checked">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ToggleButton.key:checked /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource StatusConnectingBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.key.warning:checked /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource DeclineFillBrush}" />
  </Style>
  <Style Selector="ToggleButton.key:disabled">
    <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
  </Style>

  <!-- MARK: Поле набора -->

  <!--
      PanelTextBoxStyle: поле без своей рамки — рамка у плашки вокруг него, а
      подсказка третьестепенным цветом.
  -->
  <Style Selector="TextBox.panel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,0,0,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.panel:pointerover /template/ Border#border, TextBox.panel:focus /template/ Border#border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.panel:disabled">
    <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
  </Style>

  <!--
      MARK: Боковой список разделов (настройки, «Управление»): выбранный —
      текст и значок акцентом без заливки, как в Параметрах Windows 10; под
      курсором строка чуть светлеет.
  -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- «Управление»: строки плотнее и скруглены, над группой — её заголовок. -->
  <Style Selector="ListBox.nav.grouped ListBoxItem">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBox.nav.grouped ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
  </Style>

  <!-- MARK: Меню -->

  <!-- Меню капсулы и значка: поверхность со скруглением 8, строки по 32. -->
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="160" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
  </Style>
  <Style Selector="MenuItem:pointerover /template/ Border#root, MenuItem:selected /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}" />
    <Setter Property="Margin" Value="8,4" />
  </Style>

</Styles>
