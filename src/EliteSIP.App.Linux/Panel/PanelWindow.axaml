<!--
    Панель софтфона — перевод исторический Windows EliteSIP.App/Panel/PanelWindow.xaml.
    Строки, отступы и кегли те же: шапка 22, поле 52, клавиши управления 2 × 2
    по 32 и больше, макросы, нижний ряд 46 («Позвонить» и «История» 64).
    Почему так — в комментариях WPF-разметки; здесь их не повторяем.

    Высоты строк, зависящие от макросов (WPF делал их MultiDataTrigger на
    RowDefinition), выставляет код окна: у RowDefinition в Avalonia нет стилей.
-->
<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="using:EliteSIP.App.Theme" xmlns:panel="using:EliteSIP.App.Panel" xmlns:res="using:EliteSIP.App.Resources" x:Class="EliteSIP.App.Panel.PanelWindow" x:DataType="panel:PanelViewModel" Title="{res:Loc PanelWindowTitle}" Width="324" MinWidth="270" SizeToContent="Height" CanResize="True" WindowStartupLocation="CenterScreen" Icon="avares://EliteSIP.App.Linux/Assets/elitesip.png">

  <Border Name="Frame">
    <Grid Name="Root" Margin="8" RowDefinitions="22,8,*,8,Auto">

      <!-- MARK: Шапка: капсула профиля, состояние, настройки -->
      <Grid Grid.Row="0" Name="StatusRow" ColumnDefinitions="Auto,*,Auto">
        <Button Name="ProfilePill" Grid.Column="0" Classes="surface pill" IsEnabled="{Binding CanOpenProfileMenu}" Click="OnProfileClick" AutomationProperties.Name="{Binding StatusTitle, StringFormat='Профиль {0}'}">
          <Button.ContextMenu>
            <ContextMenu Name="ProfileMenu" Placement="BottomEdgeAlignedLeft">
              <MenuItem Name="SingleProfile" Header="{Binding ProfileMenuTitle}" ToggleType="CheckBox" IsChecked="{Binding IsOnline, Mode=OneWay}" Command="{Binding GoOnline}"/>
              <Separator/>
              <MenuItem Name="OfflineMenuItem" Header="{res:Loc PanelOffline}" ToggleType="CheckBox" IsChecked="{Binding IsOfflineByChoice, Mode=OneWay}" Command="{Binding GoOffline}"/>
              <Separator/>
              <MenuItem Name="QuitMenuItem" Header="{res:Loc TrayQuit}" Command="{Binding Quit}"><MenuItem.Icon><theme:Icon Glyph="settings.unplug" Size="16"/></MenuItem.Icon></MenuItem>
            </ContextMenu>
          </Button.ContextMenu>
          <Grid><TextBlock Name="OfflineProfileLabel" Text="{res:Loc PanelOffline}" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsOfflineByChoice}"/><Grid Name="OnlineProfileIdentity" IsVisible="{Binding !IsOfflineByChoice}" VerticalAlignment="Center" ColumnDefinitions="16,Auto,*,Auto">
            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Classes.registering="{Binding Registration, Converter={x:Static theme:Converters.Equal}, ConverterParameter=Registering}" Classes.registered="{Binding Registration, Converter={x:Static theme:Converters.Equal}, ConverterParameter=Registered}" Classes.failed="{Binding Registration, Converter={x:Static theme:Converters.Equal}, ConverterParameter=Failed}" Classes.offline="{Binding IsOfflineByChoice}"/>
            <TextBlock Grid.Column="1" Text="{Binding StatusTitle}" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Grid.Column="2" theme:Emoji.Text="{Binding StatusLabel}" Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding StatusLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <theme:Icon Grid.Column="3" Glyph="chevron.down" Size="10" Margin="5,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding CanOpenProfileMenu}"/>
          </Grid></Grid>
        </Button>

        <!-- Беда связи: «нет сети», «отказ сервера» — поверх всего остального. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,6,0" VerticalAlignment="Center" IsVisible="{Binding Trouble, Converter={x:Static ObjectConverters.IsNotNull}}">
          <theme:Icon Glyph="{Binding Trouble.Glyph}" Size="10" VerticalAlignment="Center" Foreground="{DynamicResource CautionBrush}" IsVisible="{Binding Trouble.Glyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <TextBlock Text="{Binding Trouble.Text}" Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource CautionBrush}"/>
        </StackPanel>

        <!-- Короткий статус: «подключаюсь», «исправляю сеть», «микрофон молчит». -->
        <Grid Grid.Column="1" Margin="6,0,6,0" VerticalAlignment="Center" ColumnDefinitions="Auto,*" IsVisible="{Binding ShowsActivity}">
          <theme:Icon Glyph="{Binding Activity.Glyph}" Size="10" VerticalAlignment="Center" Classes="activity" Classes.warning="{Binding Activity.IsWarning, FallbackValue=False}"/>
          <TextBlock Grid.Column="1" Text="{Binding Activity.Text}" Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Classes="activity" Classes.warning="{Binding Activity.IsWarning, FallbackValue=False}"/>
        </Grid>

        <Button Grid.Column="1" Margin="6,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Left" Classes="surface chrome" Command="{Binding DismissNotice}" IsVisible="{Binding ShowsNotice}">
          <TextBlock theme:Emoji.Text="{Binding Notice}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Button>

        <Button Grid.Column="2" Classes="surface chrome" Command="{Binding ShowSettings}" ToolTip.Tip="{res:Loc PanelSettings}">
          <theme:Icon Glyph="slider.horizontal.2" Size="16"/>
        </Button>
      </Grid>

      <!-- MARK: Середина: номер или разговор, клавиши, макросы, перевод -->
      <Grid Grid.Row="2" Name="Middle" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <!-- Поле номера постоянной высоты, как в Windows-версии (72). -->
        <Grid Grid.Row="0" Name="CallField" Height="72">
          <Border CornerRadius="{StaticResource ControlCornerRadius}" Padding="12,0" Background="{DynamicResource CallFieldBrush}" IsVisible="{Binding !HasSecondLine}">
            <Grid>
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsInCall}">
                <TextBox Name="DialedField" Grid.Column="0" Classes="panel" Text="{Binding DialedNumber}" PlaceholderText="{res:Loc PanelNumberPlaceholder}" FontSize="20" KeyDown="OnDialedNumberKeyDown" TextInput="OnDialedNumberTextInput"/>
                <Button Grid.Column="1" Classes="surface chrome" ToolTip.Tip="{res:Loc PanelClearNumber}" Click="OnClearNumberClick" IsVisible="{Binding HasDialedNumber}">
                  <theme:Icon Glyph="xmark.circle.fill" Size="12"/>
                </Button>
              </Grid>

              <!-- Звонок: имя сверху; под ним номер, а справа внизу — состояние и
                   крупное время разговора, всегда на одном месте. Раньше время
                   стояло рядом с именем и гуляло вместе с его длиной. -->
              <Grid Name="CallCard" RowDefinitions="Auto,Auto" VerticalAlignment="Center" IsVisible="{Binding IsInCall}">
                <TextBlock Grid.Row="0" theme:Emoji.Text="{Binding CallTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,1,0,0">
                  <TextBlock Grid.Column="0" Text="{Binding ActiveLine.SecondaryNumber}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding !IsOutgoingPending}"/>
                  <TextBlock Grid.Column="1" Text="{Binding CallStatus}" FontSize="12" VerticalAlignment="Center" Margin="8,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBlock Grid.Column="2" Name="CallDuration" Text="{Binding ActiveLine.Duration}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" IsVisible="{Binding !IsOutgoingPending}"/>
                </Grid>
              </Grid>
</Grid>
          </Border>

          <!-- Две линии и больше — строкой на линию вместо поля. -->
          <ItemsControl ItemsSource="{Binding Lines}" VerticalAlignment="Center" IsVisible="{Binding HasSecondLine}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="panel:CallLineViewModel">
                <Border Height="22" Margin="0,0,0,4" CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,0" Background="{DynamicResource ControlBackgroundBrush}">
                  <Grid ColumnDefinitions="8,*,Auto">
                    <Ellipse Grid.Column="0" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="line" Classes.active="{Binding IsActive}"/>
                    <TextBlock Grid.Column="1" theme:Emoji.Text="{Binding Title}" Margin="6,0,4,0" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <Border Grid.Row="1" Height="8"/>

        <!-- Громкость и клавиши управления. Громкость собеседника и своего
             микрофона КЦ подстраивает постоянно — она на панели, а не в
             настройках, и это те же значения, что там: ползунки двигаются
             вместе. «Перевести» и «Конференция» нужны редко — они в «⋯». -->
        <!-- Номер, под ним громкость звука и громкость микрофона — широкие
             фреймы высотой с поле номера (значок микрофона — его отключение),
             дальше три маленькие клавиши-значка: удержать, конференция,
             перевести. Растягивание — макросам, без них поровну фреймам. -->
        <Grid Grid.Row="2" Name="ControlKeys">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="72"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*" MinHeight="72"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="40"/>
          </Grid.RowDefinitions>
          <Grid.Styles>
            <Style Selector="Border.volume-frame">
              <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
              <Setter Property="Padding" Value="10,8,12,8"/>
              <Setter Property="Background" Value="{DynamicResource CallFieldBrush}"/>
            </Style>
            <Style Selector="ToggleButton.volume-head">
              <Setter Property="MinHeight" Value="0"/>
              <Setter Property="Height" Value="28"/>
              <Setter Property="MinWidth" Value="132"/>
              <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
              <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <Style Selector="ToggleButton.volume-head > StackPanel">
              <Setter Property="Margin" Value="10,0,12,0"/>
            </Style>
            <!-- Клавиша, о которой спрашивает подтверждение. -->
            <Style Selector="ToggleButton.key.asking /template/ Border#Surface">
              <Setter Property="Background" Value="{DynamicResource StatusConnectingBrush}"/>
              <Setter Property="BorderBrush" Value="Transparent"/>
            </Style>
            <Style Selector="ToggleButton.key.asking">
              <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="Grid#KeysRow ToggleButton.key">
              <Setter Property="MinHeight" Value="0"/>
            </Style>
          </Grid.Styles>

          <Border Grid.Row="0" Name="PeerVolumeFrame" Classes="volume-frame" IsVisible="{Binding ShowsVolume}">
            <Grid RowDefinitions="Auto,Auto" VerticalAlignment="Center">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                <!-- Нажатие уводит звук собеседника в ноль и краснеет; повторное
                     возвращает прежнюю громкость. -->
                <ToggleButton Grid.Column="0" Grid.ColumnSpan="2" Name="PeerMuteKey" Classes="key warning volume-head" IsChecked="{Binding Audio.PlaybackVolume, Mode=OneWay, Converter={x:Static theme:Converters.IsZero}}" Click="OnPeerMuteClick" ToolTip.Tip="{res:Loc PanelPeerVolume}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <theme:Icon Glyph="settings.headphones" Size="16" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}"/>
                    <TextBlock Text="{res:Loc PanelPeerVolume}" FontSize="13" VerticalAlignment="Center"/>
                  </StackPanel>
                </ToggleButton>
                <TextBlock Grid.Column="2" Text="{Binding Audio.PlaybackVolume, Converter={x:Static theme:Converters.Percent}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </Grid>
              <Slider Grid.Row="1" Name="PeerVolume" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.05" Value="{Binding Audio.PlaybackVolume}" AutomationProperties.Name="{res:Loc PanelPeerVolume}"/>
            </Grid>
          </Border>
          <Border Grid.Row="2" Name="MicrophoneVolumeFrame" Classes="volume-frame" IsVisible="{Binding ShowsVolume}">
            <Grid RowDefinitions="Auto,Auto" VerticalAlignment="Center">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                <!-- Нажатие выключает микрофон и краснеет; повторное включает. -->
                <ToggleButton Grid.Column="0" Grid.ColumnSpan="2" Name="MicrophoneVolumeIcon" Classes="key warning volume-head" IsChecked="{Binding IsMicrophoneMuted, Mode=OneWay}" IsEnabled="{Binding CanMuteMicrophone}" Command="{Binding ToggleMicrophone}" ToolTip.Tip="{res:Loc PanelMicrophone}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Panel VerticalAlignment="Center">
                      <theme:Icon Glyph="settings.mic" Size="16" Foreground="{Binding $parent[ToggleButton].Foreground}" IsVisible="{Binding !IsMicrophoneMuted}"/>
                      <theme:Icon Glyph="mic.slash.fill" Size="14" Foreground="{Binding $parent[ToggleButton].Foreground}" IsVisible="{Binding IsMicrophoneMuted}"/>
                    </Panel>
                    <TextBlock Text="{res:Loc PanelMicrophone}" FontSize="13" VerticalAlignment="Center"/>
                  </StackPanel>
                </ToggleButton>
                <TextBlock Grid.Column="2" Text="{Binding Audio.MicrophoneGain, Converter={x:Static theme:Converters.Percent}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </Grid>
              <Slider Grid.Row="1" Name="MicrophoneVolume" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.05" Value="{Binding Audio.MicrophoneGain}" IsEnabled="{Binding Audio.GainIsAdjustable}" AutomationProperties.Name="{res:Loc PanelMyVolume}"/>
            </Grid>
          </Border>

          <!-- Номер перевода — всплывающим окном над клавишами: раньше поле
               вставало вместо макросов, и сетка клавиш пропадала. -->
          <Popup Grid.Row="4" Name="TransferPopup" PlacementTarget="{Binding #KeysRow}" Placement="TopEdgeAlignedLeft" IsLightDismissEnabled="True" IsOpen="{Binding IsTransferEntryVisible, Mode=OneWay}" Closed="OnTransferPopupClosed">
            <Border Width="{Binding #KeysRow.Bounds.Width}" Padding="8" Margin="0,0,0,6" CornerRadius="{StaticResource ControlCornerRadius}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
              <StackPanel Spacing="6">
                <Border Height="38" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12,0" Background="{DynamicResource CallFieldBrush}">
                  <TextBox Name="TransferField" Classes="panel" Text="{Binding TransferNumber}" PlaceholderText="{res:Loc PanelTransferNumber}" FontSize="18" IsEnabled="{Binding !IsTransferring}" KeyDown="OnTransferFieldKeyDown"/>
                </Border>
                <Grid ColumnDefinitions="*,6,*">
                  <Button Grid.Column="0" Classes="surface" Height="32" HorizontalAlignment="Stretch" Content="{res:Loc PanelCancel}" FontSize="14" Click="OnCancelTransferClick"/>
                  <Button Grid.Column="2" Classes="surface call" Height="32" HorizontalAlignment="Stretch" Content="{res:Loc PanelTransfer}" FontSize="14" IsEnabled="{Binding HasTransferNumber}" Command="{Binding Transfer}"/>
                </Grid>
              </StackPanel>
            </Border>
          </Popup>

          <!-- Подтверждение удержания и конференции — от случайного щелчка:
               клавиши маленькие и стоят рядом. -->
          <Popup Grid.Row="4" Name="ConfirmPopup" PlacementTarget="{Binding #KeysRow}" Placement="TopEdgeAlignedLeft" IsLightDismissEnabled="True" Closed="OnConfirmPopupClosed">
            <Border Width="{Binding #KeysRow.Bounds.Width}" Padding="10" Margin="0,0,0,6" CornerRadius="{StaticResource ControlCornerRadius}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <theme:Icon Name="ConfirmIcon" Size="14" VerticalAlignment="Center"/>
                  <TextBlock Name="ConfirmText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,6,*">
                  <Button Grid.Column="0" Classes="surface" Height="32" HorizontalAlignment="Stretch" Content="{res:Loc PanelCancel}" FontSize="14" Click="OnConfirmCancelClick"/>
                  <Button Grid.Column="2" Name="ConfirmAction" Classes="surface call" Height="32" HorizontalAlignment="Stretch" FontSize="14" Click="OnConfirmClick"/>
                </Grid>
              </StackPanel>
            </Border>
          </Popup>

          <Grid Grid.Row="4" Name="KeysRow" ColumnDefinitions="*,8,*,8,*">
            <ToggleButton Grid.Column="0" Classes="key" Name="HoldKey" IsChecked="{Binding IsOnHold, Mode=OneWay}" IsEnabled="{Binding CanHold}" Click="OnHoldClick" ToolTip.Tip="{res:Loc PanelHold}" AutomationProperties.Name="{res:Loc PanelHold}">
              <theme:Icon Glyph="pause.fill" Size="14" Foreground="{Binding $parent[ToggleButton].Foreground}"/>
            </ToggleButton>
            <ToggleButton Grid.Column="2" Classes="key" Name="ConferenceKey" IsChecked="{Binding IsConferenceStarted, Mode=OneWay}" IsEnabled="{Binding CanStartConference}" Click="OnConferenceClick" ToolTip.Tip="{res:Loc PanelConference}" AutomationProperties.Name="{res:Loc PanelConference}">
              <theme:Icon Glyph="person.3.fill" Size="14" Foreground="{Binding $parent[ToggleButton].Foreground}"/>
            </ToggleButton>
            <ToggleButton Grid.Column="4" Classes="key" Name="TransferKey" IsChecked="{Binding IsTransferEntryVisible, Mode=OneWay}" IsEnabled="{Binding CanTransfer}" Click="OnTransferClick" ToolTip.Tip="{res:Loc PanelTransfer}" AutomationProperties.Name="{res:Loc PanelTransfer}">
              <theme:Icon Glyph="phone.arrow.right" Size="14" Foreground="{Binding $parent[ToggleButton].Foreground}"/>
            </ToggleButton>
            <!-- Без ползунков громкости микрофон отключается здесь. -->
            <ToggleButton Grid.Column="6" Name="MicrophoneKey" Classes="key warning" IsVisible="{Binding !ShowsVolume}" IsChecked="{Binding IsMicrophoneMuted, Mode=OneWay}" IsEnabled="{Binding CanMuteMicrophone}" Command="{Binding ToggleMicrophone}" ToolTip.Tip="{res:Loc PanelMicrophone}" AutomationProperties.Name="{res:Loc PanelMicrophone}">
              <Panel>
                <theme:Icon Glyph="mic.fill" Size="14" Foreground="{Binding $parent[ToggleButton].Foreground}" IsVisible="{Binding !IsMicrophoneMuted}"/>
                <theme:Icon Glyph="mic.slash.fill" Size="14" Foreground="{Binding $parent[ToggleButton].Foreground}" IsVisible="{Binding IsMicrophoneMuted}"/>
              </Panel>
            </ToggleButton>
          </Grid>
        </Grid>

        <!-- Зазор под макросами или вводом перевода; без них его нет. -->
        <Border Grid.Row="3" Name="MacroGap" Height="8"/>

        <!-- Макросы DTMF: сетка по числу столбцов из настроек. -->
        <ItemsControl Grid.Row="4" Name="Macros" ItemsSource="{Binding Macros}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding MacroColumns}" Margin="0,0,-8,-8"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="panel:MacroViewModel">
              <Button Classes="surface macro" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="{Binding $parent[ItemsControl].((panel:PanelViewModel)DataContext).EffectiveMacroHeight}" IsEnabled="{Binding $parent[ItemsControl].((panel:PanelViewModel)DataContext).CanSendDtmf}" Command="{Binding $parent[ItemsControl].((panel:PanelViewModel)DataContext).SendMacro}" CommandParameter="{Binding}">
                <theme:ShrinkBox BaseFontSize="18" Margin="0" GrowsWithHeight="False" FallbackHeight="{Binding $parent[ItemsControl].((panel:PanelViewModel)DataContext).MacroLabelMaxHeight}">
                  <TextBlock theme:Emoji.Text="{Binding Title}" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap"/>
                </theme:ShrinkBox>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </Grid>

      <!-- MARK: Нижний ряд: позвонить или положить трубку, история -->
      <Grid Grid.Row="4" Height="62" ColumnDefinitions="*,8,72">
        <Button Grid.Column="0" Classes="surface call" Classes.hangup="{Binding IsInCall}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Command="{Binding CallOrHangUp}" IsEnabled="{Binding IsCallButtonEnabled}">
          <StackPanel Orientation="Horizontal">
            <Panel VerticalAlignment="Center">
              <theme:Icon Glyph="phone.fill" Size="14" Foreground="White" IsVisible="{Binding !IsInCall}"/>
              <theme:Icon Glyph="phone.down.fill" Size="14" Foreground="White" IsVisible="{Binding IsInCall}"/>
            </Panel>
            <Panel Margin="6,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{res:Loc PanelCall}" FontSize="14" FontWeight="Medium" Foreground="White" IsVisible="{Binding !IsInCall}"/>
              <TextBlock Text="{res:Loc PanelHangUp}" FontSize="14" FontWeight="Medium" Foreground="White" IsVisible="{Binding IsInCall}"/>
            </Panel>
          </StackPanel>
        </Button>

        <Button Grid.Column="2" Classes="surface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Command="{Binding ShowHistory}">
          <StackPanel>
            <theme:Icon Glyph="clock" Size="14" HorizontalAlignment="Center"/>
            <TextBlock Text="{res:Loc PanelHistory}" Margin="0,2,0,0" FontSize="11" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Grid>
  </Border>

  <Window.Styles>
    <!--
        Точка состояния регистрации: четыре цвета, «нет сети» и «отказ» разные.
        Только внутри панели (Border#Frame): стили окна достают и до рамки,
        которую рисует Avalonia, и красили бы круги её кнопок.
    -->
    <Style Selector="Border#Frame Ellipse">
      <Setter Property="Fill" Value="{DynamicResource StatusOfflineBrush}"/>
    </Style>
    <Style Selector="Border#Frame Ellipse.registering">
      <Setter Property="Fill" Value="{DynamicResource StatusConnectingBrush}"/>
    </Style>
    <Style Selector="Border#Frame Ellipse.registered">
      <Setter Property="Fill" Value="{DynamicResource StatusRegisteredBrush}"/>
    </Style>
    <Style Selector="Border#Frame Ellipse.failed">
      <Setter Property="Fill" Value="{DynamicResource StatusFailureBrush}"/>
    </Style>
    <Style Selector="Border#Frame Ellipse.offline">
      <Setter Property="Fill" Value="{DynamicResource StatusOfflineBrush}"/>
    </Style>
    <Style Selector="Border#Frame Ellipse.line">
      <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>
    <Style Selector="Border#Frame Ellipse.line.active">
      <Setter Property="Fill" Value="{DynamicResource StatusRegisteredBrush}"/>
    </Style>

    <Style Selector="theme|Icon.activity">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="theme|Icon.activity.warning">
      <Setter Property="Foreground" Value="{DynamicResource CautionBrush}"/>
    </Style>
    <Style Selector="TextBlock.activity">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.activity.warning">
      <Setter Property="Foreground" Value="{DynamicResource CautionBrush}"/>
    </Style>
  <Style Selector="theme|BrandMark.none"><Setter Property="Foreground" Value="{DynamicResource StatusOfflineBrush}"/></Style><Style Selector="theme|BrandMark.registering"><Setter Property="Foreground" Value="{DynamicResource StatusConnectingBrush}"/></Style><Style Selector="theme|BrandMark.registered"><Setter Property="Foreground" Value="{DynamicResource StatusRegisteredBrush}"/></Style><Style Selector="theme|BrandMark.failed"><Setter Property="Foreground" Value="{DynamicResource StatusFailureBrush}"/></Style><Style Selector="theme|BrandMark.offline"><Setter Property="Foreground" Value="{DynamicResource StatusOfflineBrush}"/></Style>
</Window.Styles>
</Window>
