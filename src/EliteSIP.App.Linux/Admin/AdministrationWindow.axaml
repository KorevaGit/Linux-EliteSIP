<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="using:EliteSIP.App.Theme" xmlns:admin="using:EliteSIP.App.Admin" xmlns:settings="using:EliteSIP.App.Settings" xmlns:res="using:EliteSIP.App.Resources" x:Class="EliteSIP.App.Admin.AdministrationWindow" Classes="admin-window" x:DataType="admin:AdministrationViewModel" Title="{res:Loc AdminWindowTitle}" Width="840" Height="540" MinWidth="740" MinHeight="440" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" FontSize="13">
  <Grid x:Name="AdministrationRoot" Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="150"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <DockPanel Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10,10,0,7">
        <theme:Icon Glyph="settings.shield-check" Size="15"/>
        <TextBlock Text="{res:Loc AdminAccessOpenSession}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
      </StackPanel>
      <ListBox ItemsSource="{Binding Sections}" SelectedValue="{Binding Section}" SelectedValueBinding="{ReflectionBinding Kind}" Background="Transparent" BorderThickness="0" Padding="0" Classes="nav" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <theme:Icon Glyph="{Binding Glyph}" Size="18"/>
              <TextBlock Text="{Binding Title}" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="AdminScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,0,0,0">
        <StackPanel x:Name="AdminPages" Margin="0,0,0,4">
          <Grid Height="43">
            <TextBlock Text="{Binding SectionTitle}" FontSize="21" FontWeight="SemiBold" Margin="5,0,0,7" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel IsVisible="{Binding ShowsAccount}">
            <theme:SettingsSection Header="" Tag="settings.users-round">
              <Grid Margin="0,8,0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <theme:Icon Glyph="settings.users-round" Size="14" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBlock Text="{res:Loc AdminProfiles}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="settings" Height="28" FontSize="12" Click="OnAddAccount" ToolTip.Tip="{res:Loc AdminProfileSwitchHint}">
                  <StackPanel Orientation="Horizontal"><theme:Icon Glyph="settings.users-round" Size="14"/><TextBlock Text="{res:Loc AdminProfileAdd}" Margin="6,0,0,0"/></StackPanel>
                </Button>
              </Grid>
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="88"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="146"/>
                  <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{res:Loc AdminAccountUsername}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{res:Loc AdminProfileLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="4" Text="{res:Loc AdminAccountPassword}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </Grid>
              <ItemsControl x:Name="AccountItems" ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="admin:AdminAccountDraft">
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="146"/>
                        <ColumnDefinition Width="38"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Tag="AccountNumber" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{res:Loc AdminAccountUsername}"/>
                      <TextBox Grid.Column="2" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{res:Loc AdminProfileLabel}"/>
                      <TextBox Grid.Column="4" PasswordChar="●" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{res:Loc AdminAccountPassword}"/>
                      <theme:Icon Grid.Column="5" Glyph="settings.check" Size="15" Foreground="{DynamicResource StatusRegisteredBrush}" VerticalAlignment="Center" IsVisible="{Binding IsActive}" ToolTip.Tip="{res:Loc AdminActiveProfile}"/>
                      <Button Grid.Column="5" Classes="settings small" Margin="6,0,0,0" Click="OnRemoveAccount" IsVisible="{Binding IsActive, Converter={x:Static theme:Converters.Not}}" ToolTip.Tip="{res:Loc AdminProfileRemove}" AutomationProperties.Name="{res:Loc AdminProfileRemove}">
                        <theme:Icon Glyph="trash" Size="14"/>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </theme:SettingsSection>
            <theme:SettingsSection Header="{res:Loc AdminPbxTitle}" Tag="settings.server">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                <StackPanel MinWidth="62" Margin="12,0">
                  <theme:Icon Glyph="settings.monitor" Size="25" HorizontalAlignment="Center"/>
                  <TextBlock Text="{res:Loc SettingsThisPc}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center"/>
                <StackPanel MinWidth="62" Margin="12,0">
                  <theme:Icon Glyph="settings.router" Size="25" HorizontalAlignment="Center"/>
                  <TextBlock Text="{res:Loc WorkPlace}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center"/>
                <StackPanel MinWidth="62" Margin="12,0">
                  <theme:Icon Glyph="settings.server" Size="25" HorizontalAlignment="Center"/>
                  <TextBlock Text="АТС" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
              </StackPanel>
              <theme:SettingsRow Header="{res:Loc AdminPbxOffice}">
                <TextBox Height="33" Text="{Binding OfficeAddress, UpdateSourceTrigger=PropertyChanged}"/>
              </theme:SettingsRow>
              <theme:SettingsRow Header="{res:Loc AdminPbxRemote}">
                <TextBox Height="33" Text="{Binding RemoteAddress, UpdateSourceTrigger=PropertyChanged}"/>
              </theme:SettingsRow>
              <Expander Header="{res:Loc AdminConnectionAdvanced}">
                <StackPanel>
                  <theme:SettingsRow Header="{res:Loc AdminPbxPort}">
                    <TextBox Height="33" Width="90" HorizontalAlignment="Left" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                  </theme:SettingsRow>
                  <theme:SettingsRow Header="{res:Loc AdminPbxTransport}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Classes="segment" GroupName="Transport" Content="UDP" IsChecked="{Binding Transport, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Udp}"/>
                      <RadioButton Classes="segment" GroupName="Transport" Content="TCP" IsChecked="{Binding Transport, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Tcp}"/>
                      <RadioButton Classes="segment" GroupName="Transport" Content="TLS" IsChecked="{Binding Transport, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Tls}"/>
                    </StackPanel>
                  </theme:SettingsRow>
                  <theme:SettingsRow Header="{res:Loc AdminPbxExpiry}">
                    <TextBox Height="33" Width="90" HorizontalAlignment="Left" Text="{Binding RegistrationExpirySeconds, UpdateSourceTrigger=PropertyChanged}"/>
                  </theme:SettingsRow>
                  <theme:SettingsSection Header="{res:Loc AdminPbxTlsTitle}" IsVisible="{Binding IsTls}" Tag="settings.circle">
                    <theme:SettingsRow Header="{res:Loc AdminPbxTlsFingerprint}">
                      <TextBox Height="33" IsEnabled="{Binding AcceptsAnyTlsCertificate, Converter={x:Static theme:Converters.Not}}" Text="{Binding PinnedCertificateFingerprint, UpdateSourceTrigger=PropertyChanged}"/>
                    </theme:SettingsRow>
                    <theme:SettingsDivider/>
                    <CheckBox Classes="switch" IsChecked="{Binding AcceptsAnyTlsCertificate}">
                      <StackPanel Orientation="Horizontal">
                        <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center"/>
                        <TextBlock Text="{res:Loc AdminPbxTlsAcceptAny}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      </StackPanel>
                    </CheckBox>
                  </theme:SettingsSection>
                </StackPanel>
              </Expander>
              <Expander Header="{res:Loc AdminKnockTitle}">
                <StackPanel>
                  <theme:SettingsSection Header="{res:Loc AdminKnockTitle}" Tag="settings.circle">
                    <ItemsControl ItemsSource="{Binding KnockSteps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="settings:PortKnockStepSetting">
                          <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="6"/>
                              <ColumnDefinition Width="70"/>
                              <ColumnDefinition Width="6"/>
                              <ColumnDefinition Width="50"/>
                              <ColumnDefinition Width="6"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Height="33" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Tag="{res:Loc AdminKnockHost}"/>
                            <TextBox Grid.Column="2" Height="33" FontFamily="Consolas" Text="{Binding PayloadBytes, UpdateSourceTrigger=PropertyChanged}" Tag="{res:Loc AdminKnockBytes}"/>
                            <TextBox Grid.Column="4" Height="33" FontFamily="Consolas" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Tag="{res:Loc AdminKnockCount}"/>
                            <Button Grid.Column="6" Classes="settings" Padding="6,2" ToolTip.Tip="{res:Loc AdminMacroRemove}" Click="OnKnockRemoveClick">
                              <theme:Icon Glyph="trash" Size="12"/>
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <theme:SettingsIndented>
                      <Button Classes="settings" HorizontalAlignment="Left" Content="{res:Loc AdminKnockAdd}" Click="OnKnockAddClick"/>
                    </theme:SettingsIndented>
                    <theme:SettingsDivider/>
                    <theme:SettingsRow Header="{res:Loc AdminKnockSpacing}">
                      <TextBox Height="33" Width="90" HorizontalAlignment="Left" Text="{Binding KnockSpacingSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                    </theme:SettingsRow>
                    <theme:SettingsRow Header="{res:Loc AdminKnockRepeat}">
                      <TextBox Height="33" Width="90" HorizontalAlignment="Left" Text="{Binding KnockRepeatIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                    </theme:SettingsRow>
                    <theme:SettingsNote Text="{Binding KnockSummary}"/>
                  </theme:SettingsSection>
                </StackPanel>
              </Expander>
            </theme:SettingsSection>
          </StackPanel>
          <StackPanel IsVisible="{Binding ShowsMacros}">
            <theme:SettingsSection Header="{res:Loc AdminMacrosTitle}" Tag="settings.panels-top-left">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="102"/>
                  <ColumnDefinition Width="128"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{res:Loc AdminMacroTitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{res:Loc AdminMacroSequence}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{res:Loc AdminMacroTransferShort}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding Macros}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="settings:MacroSetting">
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="86"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{res:Loc AdminMacroTitle}"/>
                      <TextBox Grid.Column="2" Text="{Binding Sequence, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{res:Loc AdminMacroSequence}"/>
                      <CheckBox Grid.Column="4" Classes="switch" IsChecked="{Binding TransfersCall}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{res:Loc AdminMacroTransfers}" AutomationProperties.Name="{res:Loc AdminMacroTransfers}"/>
                      <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Classes="settings small" Click="OnMacroUpClick" Content="↑" ToolTip.Tip="{res:Loc AdminMacroUp}"/>
                        <Button Classes="settings small" Margin="3,0" Click="OnMacroDownClick" Content="↓" ToolTip.Tip="{res:Loc AdminMacroDown}"/>
                        <Button Classes="settings small" Click="OnMacroRemoveClick" ToolTip.Tip="{res:Loc AdminMacroRemove}">
                          <theme:Icon Glyph="trash" Size="13"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <theme:SettingsIndented>
                <Button Classes="settings" HorizontalAlignment="Left" Content="{res:Loc AdminMacroAdd}" Click="OnMacroAddClick"/>
              </theme:SettingsIndented>
              <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <theme:Icon Glyph="settings.arrow-right" Size="14" VerticalAlignment="Center"/>
                <TextBlock Text="{res:Loc AdminTransferEffect}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </theme:SettingsSection>
            <theme:SettingsSection Header="{res:Loc AdminMacroLayout}" Tag="settings.panels-top-left">
              <theme:SettingsRow Header="{res:Loc AdminMacroColumns}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="segment" GroupName="Columns" Content="2" IsChecked="{Binding MacroColumns, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=2}"/>
                  <RadioButton Classes="segment" GroupName="Columns" Content="3" IsChecked="{Binding MacroColumns, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=3}"/>
                  <RadioButton Classes="segment" GroupName="Columns" Content="4" IsChecked="{Binding MacroColumns, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=4}"/>
                </StackPanel>
              </theme:SettingsRow>
              <CheckBox Classes="switch" IsChecked="{Binding MacroHeightIsManual, Converter={x:Static theme:Converters.Not}}">
                <StackPanel Orientation="Horizontal">
                  <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center"/>
                  <TextBlock Text="{res:Loc AdminMacroHeightAuto}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
              </CheckBox>
              <theme:SettingsRow Header="{res:Loc AdminMacroHeight}" IsEnabled="{Binding MacroHeightIsManual}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0" Minimum="44" Maximum="96" IsSnapToTickEnabled="True" TickFrequency="2" VerticalAlignment="Center" Value="{Binding MacroHeight}"/>
                  <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding MacroHeight}"/>
                </Grid>
              </theme:SettingsRow>
              <ItemsControl ItemsSource="{Binding Macros}" Margin="-3,4,-3,6">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding MacroColumns}"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="3" Padding="8" CornerRadius="8" Background="{DynamicResource SeparatorBrush}">

                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="{Binding Sequence}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </theme:SettingsSection>
            <theme:SettingsSection Header="{res:Loc AdminPbxFeatureTitle}" Tag="settings.headset">
              <theme:SettingsRow Header="{res:Loc AdminPbxTransfer}">
                <TextBox Height="33" Width="120" HorizontalAlignment="Left" FontFamily="Consolas" Text="{Binding TransferFeatureCode, UpdateSourceTrigger=PropertyChanged}"/>
              </theme:SettingsRow>
              <theme:SettingsRow Header="{res:Loc AdminPbxConference}">
                <TextBox Height="33" Width="120" HorizontalAlignment="Left" FontFamily="Consolas" Text="{Binding ConferenceFeatureCode, UpdateSourceTrigger=PropertyChanged}"/>
              </theme:SettingsRow>
            </theme:SettingsSection>
          </StackPanel>
          <StackPanel IsVisible="{Binding ShowsIncoming}">
            <Border Classes="tabs">
              <StackPanel Orientation="Horizontal">
                <RadioButton Classes="segment" GroupName="IncomingPage" Content="{res:Loc AdminQueuesTitle}" IsChecked="{Binding IncomingPage, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Queues}"/>
                <RadioButton Classes="segment" GroupName="IncomingPage" Content="{res:Loc AdminReceive}" IsChecked="{Binding IncomingPage, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Answer}"/>
                <RadioButton Classes="segment" GroupName="IncomingPage" Content="{res:Loc AdminGuardTitle}" IsChecked="{Binding IncomingPage, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Guard}"/>
              </StackPanel>
            </Border>
            <StackPanel IsVisible="{Binding ShowsQueues}">
              <theme:SettingsSection Header="{res:Loc AdminQueuesTitle}" Tag="settings.users-round">
                <ItemsControl ItemsSource="{Binding Queues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="settings:QueueSetting">
                      <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110"/>
                          <ColumnDefinition Width="6"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="6"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="33" FontFamily="Consolas" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Tag="{res:Loc AdminQueueNumber}"/>
                        <TextBox Grid.Column="2" Height="33" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Tag="{res:Loc AdminQueueTitle}"/>
                        <Button Grid.Column="4" Classes="settings" Padding="6,2" ToolTip.Tip="{res:Loc AdminMacroRemove}" Click="OnQueueRemoveClick">
                          <theme:Icon Glyph="trash" Size="12"/>
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <theme:SettingsIndented>
                  <Button Classes="settings" HorizontalAlignment="Left" Content="{res:Loc AdminQueueAdd}" Click="OnQueueAddClick"/>
                </theme:SettingsIndented>
              </theme:SettingsSection>
            </StackPanel>
            <StackPanel IsVisible="{Binding ShowsIncomingAnswer}">
              <theme:SettingsSection Header="{res:Loc AdminAutoAnswerTitle}" Tag="settings.headset">
                <theme:SettingsRow Header="{res:Loc AdminAutoAnswerTitle}">
                  <ComboBox SelectedValueBinding="{ReflectionBinding Tag}" SelectedValue="{Binding Guard.AutoAnswer, Mode=TwoWay}">
                    <ComboBoxItem Tag="off" Content="{res:Loc AdminAnswerOperatorShort}"/>
                    <ComboBoxItem Tag="header" Content="{res:Loc AdminAnswerHeaderShort}"/>
                    <ComboBoxItem Tag="list" Content="{res:Loc AdminAnswerListShort}"/>
                    <ComboBoxItem Tag="always" Content="{res:Loc AdminAnswerAlwaysShort}"/>
                  </ComboBox>
                </theme:SettingsRow>
                <theme:SettingsRow Header="{res:Loc AdminAutoAnswerNumbers}" Margin="0,8,0,0" IsVisible="{Binding Guard.AutoAnswerList}">
                  <Border CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,4" Background="{DynamicResource ControlBackgroundBrush}">
                    <TextBox MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding Guard.AutoAnswerNumbersText, UpdateSourceTrigger=LostFocus}"/>
                  </Border>
                </theme:SettingsRow>
                <theme:SettingsNote Text="{res:Loc AdminAutoAnswerAlwaysNote}" IsAlarming="True" IsVisible="{Binding Guard.AutoAnswerAlways}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.headset" Size="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminSectionIncoming}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center"/>
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.users-round" Size="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AutoAnswerPreview}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center"/>
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.headset" Size="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminConversation}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                </StackPanel>
              </theme:SettingsSection>
              <theme:SettingsSection Header="{res:Loc AdminNumbersTitle}" Tag="settings.headset">
                <CheckBox Classes="switch" IsChecked="{Binding Guard.MasksMobileNumbers}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminMasksMobileNumbers}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
                <TextBlock Text="{Binding MobilePreview}" Margin="25,4,0,6" FontSize="15" FontWeight="SemiBold"/>
              </theme:SettingsSection>
            </StackPanel>
            <StackPanel IsVisible="{Binding ShowsIncomingGuard}">
              <theme:SettingsSection Header="{res:Loc AdminGuardTitle}" Tag="settings.shield-check">
                <CheckBox Classes="switch" IsChecked="{Binding Guard.IsEnabled}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminGuardEnabled}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
                <theme:SettingsNote Text="{res:Loc AdminGuardOffShort}" IsAlarming="True" IsVisible="{Binding Guard.IsGuardOff}"/>
                <CheckBox Classes="switch" IsChecked="{Binding Guard.IsRandomPositionEnabled}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminGuardRandomPosition}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
                <Expander Header="{res:Loc AdminGuardRandomTitle}">
                  <StackPanel>
                    <theme:SettingsRow Header="{res:Loc AdminGuardTuning}">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="segment" GroupName="RandomTuning" Content="{res:Loc AdminGuardTuningAuto}" IsChecked="{Binding Guard.TunesRandomnessAutomatically}"/>
                        <RadioButton Classes="segment" GroupName="RandomTuning" Content="{res:Loc AdminGuardTuningManual}" IsChecked="{Binding Guard.TunesRandomnessByHand}"/>
                      </StackPanel>
                    </theme:SettingsRow>
                    <theme:SettingsRow Header="{res:Loc AdminGuardMinimumTravel}" IsEnabled="{Binding Guard.RandomnessSlidersAreEditable}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="600" IsSnapToTickEnabled="True" TickFrequency="25" VerticalAlignment="Center" Value="{Binding Guard.MinimumTravel}"/>
                        <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Guard.MinimumTravel, StringFormat={}{0:F0}}"/>
                      </Grid>
                    </theme:SettingsRow>
                    <theme:SettingsRow Header="{res:Loc AdminGuardScreenMargin}" IsEnabled="{Binding Guard.RandomnessSlidersAreEditable}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="200" IsSnapToTickEnabled="True" TickFrequency="8" VerticalAlignment="Center" Value="{Binding Guard.ScreenMargin}"/>
                        <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Guard.ScreenMargin, StringFormat={}{0:F0}}"/>
                      </Grid>
                    </theme:SettingsRow>
                  </StackPanel>
                </Expander>
                <CheckBox Classes="switch" IsChecked="{Binding Guard.AsksForDigit}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminGuardDigitEnabled}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
                <Expander Header="{res:Loc AdminGuardDigitTitle}">
                  <StackPanel>
                    <theme:SettingsRow Header="{res:Loc AdminGuardTargets}" IsEnabled="{Binding Guard.AsksForDigit}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="2" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Value="{Binding Guard.TargetCount}"/>
                        <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Guard.TargetCount}"/>
                      </Grid>
                    </theme:SettingsRow>
                  </StackPanel>
                </Expander>
                <CheckBox Classes="switch" IsChecked="{Binding Guard.RequiresCursorMovement}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminGuardCursor}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
                <Expander Header="{res:Loc AdminGuardLivenessTitle}">
                  <StackPanel>
                    <theme:SettingsRow Header="{res:Loc AdminGuardTuning}">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="segment" GroupName="LivenessTuning" Content="{res:Loc AdminGuardTuningAuto}" IsChecked="{Binding Guard.TunesLivenessAutomatically}"/>
                        <RadioButton Classes="segment" GroupName="LivenessTuning" Content="{res:Loc AdminGuardTuningManual}" IsChecked="{Binding Guard.TunesLivenessByHand}"/>
                      </StackPanel>
                    </theme:SettingsRow>
                    <theme:SettingsRow Header="{res:Loc AdminGuardCursorTravel}" IsEnabled="{Binding Guard.LivenessSlidersAreEditable}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="200" IsSnapToTickEnabled="True" TickFrequency="10" VerticalAlignment="Center" Value="{Binding Guard.RequiredCursorTravel}"/>
                        <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Guard.RequiredCursorTravel, StringFormat={}{0:F0}}"/>
                      </Grid>
                    </theme:SettingsRow>
                    <CheckBox Classes="switch" IsChecked="{Binding Guard.RejectsSyntheticEvents}">
                      <StackPanel Orientation="Horizontal">
                        <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center"/>
                        <TextBlock Text="{res:Loc AdminGuardSynthetic}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      </StackPanel>
                    </CheckBox>
                  </StackPanel>
                </Expander>
              </theme:SettingsSection>
            </StackPanel>
            <theme:SettingsSection Header="{res:Loc AdminGuardCheckTitle}" Tag="settings.activity">
              <Border Background="{DynamicResource FieldBrush}" CornerRadius="9" Padding="12" Margin="0,3,0,10">
                <Grid MinHeight="82">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <theme:Icon Grid.RowSpan="2" Glyph="settings.headset" Size="28" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding IncomingPreviewTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding MobilePreview}" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Grid>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{res:Loc AdminReceivePreview}" FontSize="11" Margin="0,0,0,7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel>
                      <ItemsControl ItemsSource="{Binding PreviewDigits}" IsVisible="{Binding ShowsDigitExample}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border CornerRadius="7" Background="{DynamicResource SeparatorBrush}" Padding="8" Margin="0,0,4,4">
                              <TextBlock Text="{Binding}" HorizontalAlignment="Center"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <UniformGrid Columns="2" IsVisible="{Binding ShowsAnswerExample}">
                        <Border CornerRadius="7" Background="{DynamicResource AnswerFillBrush}" Padding="7" Margin="0,0,4,0">
                          <TextBlock Text="{res:Loc IncomingAnswer}" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="7" Background="{DynamicResource DeclineFillBrush}" Padding="7">
                          <TextBlock Text="{res:Loc IncomingDecline}" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                      </UniformGrid>
                      <StackPanel IsVisible="{Binding ShowsAutomaticExample}">
                        <theme:Icon Glyph="settings.headset" Size="25" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AutoAnswerPreview}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
              <theme:SettingsIndented>
                <WrapPanel>
                  <Button Classes="settings" Content="{res:Loc AdminGuardCheckShow}" Command="{Binding PreviewDistribution}"/>
                  <Button Classes="settings" Margin="6,0,0,0" Content="{res:Loc AdminGuardCheckDeal}" Command="{Binding PreviewDeal}"/>
                </WrapPanel>
              </theme:SettingsIndented>
              <theme:SettingsRow Header="{res:Loc AdminGuardLastCall}" IsVisible="{Binding LastGuardReport, Converter={x:Static theme:Converters.Present}}">
                <TextBlock Text="{Binding LastGuardReport}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </theme:SettingsRow>
            </theme:SettingsSection>
          </StackPanel>
          <StackPanel IsVisible="{Binding ShowsSystem}">
            <Border Classes="tabs">
              <StackPanel Orientation="Horizontal">
                <RadioButton Classes="segment" GroupName="SystemPage" Content="{res:Loc AdminData}" IsChecked="{Binding SystemPage, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Data}"/>
                <RadioButton Classes="segment" GroupName="SystemPage" Content="{res:Loc AdminAccessShort}" IsChecked="{Binding SystemPage, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Access}"/>
                <RadioButton Classes="segment" GroupName="SystemPage" Content="{res:Loc AdminUpdateShort}" IsChecked="{Binding SystemPage, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Updates}"/>
                <RadioButton Classes="segment" GroupName="SystemPage" Content="{res:Loc AdminResetTitle}" IsChecked="{Binding SystemPage, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Reset}"/>
              </StackPanel>
            </Border>
            <StackPanel IsVisible="{Binding ShowsHistory}">
              <theme:SettingsSection Header="{res:Loc AdminHistoryTitle}" Tag="settings.activity">
                <CheckBox Classes="switch" IsChecked="{Binding HistoryIsEnabled}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminHistoryEnabled}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
                <theme:SettingsRow Header="{res:Loc AdminHistoryAge}" IsEnabled="{Binding HistoryIsEnabled}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="1" Maximum="365" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Value="{Binding HistoryAgeInDays}"/>
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding HistoryAgeInDays}"/>
                  </Grid>
                </theme:SettingsRow>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.headset" Size="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminCall}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center"/>
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.activity" Size="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding HistoryAgeInDays, StringFormat={}{0} дн.}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center"/>
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.archive" Size="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminRetentionEffect}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                </StackPanel>
              </theme:SettingsSection>
              <theme:SettingsSection Header="{res:Loc AdminMaintenanceTitle}" Tag="settings.file-text">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.file-text" Size="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminLogShort}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center"/>
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.archive" Size="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="{res:Loc SettingsSupportArchive}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                </StackPanel>
                <CheckBox Classes="switch" IsChecked="{Binding LogToFile}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminMaintenanceLog}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
                <CheckBox Classes="switch" IsEnabled="{Binding LogToFile}" IsChecked="{Binding LogsSipTrace}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminMaintenanceTrace}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
                <theme:SettingsDivider/>
                <theme:SettingsIndented>
                  <Button Classes="settings" HorizontalAlignment="Left" Content="{res:Loc AdminDiagnosticsOpenFolder}" Click="OnOpenFolderClick"/>
                </theme:SettingsIndented>
              </theme:SettingsSection>
            </StackPanel>
            <StackPanel IsVisible="{Binding ShowsAccess}">
              <theme:SettingsSection Header="{res:Loc AdminAccessTitle}" Tag="settings.lock-keyhole">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.monitor" Size="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="{res:Loc SettingsManagement}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center"/>
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.lock-keyhole" Size="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AccessStatus}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                </StackPanel>
                <theme:SettingsRow Header="{res:Loc AdminAccessNewPassword}">
                  <TextBox Height="33" x:Name="NewPasswordField" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" PasswordChar="●" Classes="panel" TextChanged="OnNewPasswordChanged"/>
                </theme:SettingsRow>
                <theme:SettingsRow Header="{res:Loc AdminAccessRepeatPassword}">
                  <TextBox Height="33" x:Name="RepeatedPasswordField" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" PasswordChar="●" Classes="panel" TextChanged="OnRepeatedPasswordChanged"/>
                </theme:SettingsRow>
                <theme:SettingsNote Text="{res:Loc AdminAccessMismatch}" IsAlarming="True" IsVisible="{Binding PasswordsDiffer}"/>
                <theme:SettingsIndented>
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="settings" Content="{res:Loc AdminAccessSet}" IsEnabled="{Binding CanSetPassword}" Click="OnSetPasswordClick"/>
                    <Button Classes="settings" Margin="6,0,0,0" Content="{res:Loc AdminAccessRemove}" IsEnabled="{Binding IsProtected}" Click="OnRemovePasswordClick"/>
                  </StackPanel>
                </theme:SettingsIndented>
              </theme:SettingsSection>
            </StackPanel>
            <StackPanel IsVisible="{Binding ShowsDiagnostics}">
              <theme:SettingsSection Header="{res:Loc AdminDiagnosticsTitle}" Tag="settings.package">
                <theme:SettingsRow Header="{res:Loc SupportVersion}">
                  <TextBlock Text="{Binding Version}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </theme:SettingsRow>
                <theme:SettingsRow Header="{res:Loc AdminDiagnosticsSettingsPath}">
                  <TextBlock Text="{Binding SettingsPath}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </theme:SettingsRow>
                <theme:SettingsIndented>
                  <Button Classes="settings" HorizontalAlignment="Left" Content="{res:Loc AdminDiagnosticsOpenFolder}" Click="OnOpenFolderClick"/>
                </theme:SettingsIndented>
                <StackPanel DataContext="{Binding Updates}" IsVisible="{Binding Converter={x:Static theme:Converters.Present}}">
                  <theme:SettingsDivider/>
                  <theme:SettingsIndented>
                    <StackPanel Orientation="Horizontal">
                      <Button Classes="settings" Content="{res:Loc AdminDiagnosticsCheckUpdates}" Command="{Binding CheckNow}"/>
                      <Button Classes="settings" Margin="6,0,0,0" Content="{res:Loc AdminDiagnosticsInstallUpdate}" Command="{Binding Install}" IsVisible="{Binding IsReady}"/>
                    </StackPanel>
                  </theme:SettingsIndented>
                  <theme:SettingsNote Text="{Binding Status}" IsVisible="{Binding HasStatus}"/>
                </StackPanel>
              </theme:SettingsSection>
            </StackPanel>
            <StackPanel IsVisible="{Binding ShowsReset}">
              <theme:SettingsSection Header="{res:Loc AdminResetTitle}" Tag="settings.refresh-cw">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.file-text" Size="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminResetData}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center"/>
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.unplug" Size="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="{res:Loc AdminResetGone}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                </StackPanel>
                <theme:SettingsIndented>
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="settings" Content="{res:Loc AdminResetButton}" IsEnabled="{Binding CanResetMachine}" Click="OnResetMachineClick"/>
                    <TextBlock Text="{res:Loc AdminResetInCall}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">

                    </TextBlock>
                  </StackPanel>
                </theme:SettingsIndented>
                <theme:SettingsNote Text="{res:Loc AdminResetIrreversible}" IsAlarming="True"/>
              </theme:SettingsSection>
            </StackPanel>
          </StackPanel>
          <StackPanel IsVisible="{Binding ShowsSupport}"><StackPanel DataContext="{Binding Support}">
            <theme:SettingsSection Header="{res:Loc AdminSupportTitle}" Tag="settings.cloud">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                <StackPanel MinWidth="62" Margin="12,0">
                  <theme:Icon Glyph="settings.monitor" Size="25" HorizontalAlignment="Center"/>
                  <TextBlock Text="{res:Loc SettingsThisPc}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center"/>
                <StackPanel MinWidth="62" Margin="12,0">
                  <theme:Icon Glyph="settings.cloud" Size="25" HorizontalAlignment="Center"/>
                  <TextBlock Text="Spark" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
              </StackPanel>
              <theme:SettingsRow Header="{res:Loc AdminSupportMachine}">
                <TextBlock Text="{Binding InstallationID}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </theme:SettingsRow>
              <theme:SettingsRow Header="{res:Loc AdminSupportPreset}">
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                  <Run Text="{Binding PresetName, Mode=OneWay}"/>
                  <Run Text=" · "/>
                  <Run Text="{res:Loc AdminSupportRevision}"/>
                  <Run Text=" "/>
                  <Run Text="{Binding AppliedRevision, Mode=OneWay}"/>
                </TextBlock>
              </theme:SettingsRow>
              <theme:SettingsRow Header="{res:Loc AdminSupportLastContact}">
                <TextBlock Text="{Binding LastContact}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </theme:SettingsRow>
              <theme:SettingsRow Header="{res:Loc AdminSupportLink}">
                <TextBlock Text="{Binding LinkState}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </theme:SettingsRow>
              <theme:SettingsDivider/>
              <theme:SettingsIndented>
                <Grid>
                  <Button Classes="settings" HorizontalAlignment="Left" Content="{res:Loc AdminSupportCheckNow}" Command="{Binding CheckNow}" IsVisible="{Binding IsOnline}"/>
                  <Button Classes="settings" HorizontalAlignment="Left" Content="{res:Loc SupportReturnOnline}" Command="{Binding ReturnOnline}" IsVisible="{Binding IsOffline}"/>
                </Grid>
              </theme:SettingsIndented>
              <theme:SettingsNote Text="{res:Loc SupportReturnOnlineNote}" IsVisible="{Binding IsOffline}"/>
              <theme:SettingsNote Text="{Binding Report}" IsVisible="{Binding HasReport}"/>
            </theme:SettingsSection>
          </StackPanel>
        </StackPanel></StackPanel>
      </ScrollViewer>
      <Grid x:Name="AdministrationFooter" Grid.Row="1" Margin="26,8,18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding SaveStateTitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="{Binding SaveStateBody}"/>
          <TextBlock Text="{Binding AccountError}" FontSize="11" Foreground="{DynamicResource StatusFailureBrush}" IsVisible="{Binding HasAccountError}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="settings" Content="{res:Loc AdminRevert}" Click="OnRevertClick" IsEnabled="{Binding IsDirty}"/>
          <Button Classes="settings" Content="{res:Loc AdminSave}" Click="OnSaveClick" IsEnabled="{Binding CanSave}" Margin="8,0,0,0" Foreground="{DynamicResource StatusRegisteredBrush}"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
