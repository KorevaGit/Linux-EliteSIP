<Window x:Class="EliteSIP.App.Admin.AdministrationWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="using:EliteSIP.App.Theme"
        xmlns:admin="using:EliteSIP.App.Admin"
        xmlns:settings="using:EliteSIP.App.Settings"
        xmlns:res="using:EliteSIP.App.Resources"
        x:DataType="admin:AdministrationViewModel"
        Title="{res:Loc AdminWindowTitle}"
        Width="780"
        Height="457"
        MinWidth="740"
        MinHeight="457"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FontSize="13">

  <!--
      Колонка подписей 132, а не менеджерские 72: здесь «Отображаемое имя» и
      «Время регистрации», а не «Громкость», и на 72 каждая вторая подпись
      переносилась бы в две строки.

      Высота 457 — и минимальная, и та, с которой окно открывается: её задаёт
      сайдбар, все пункты которого обязаны быть видны сразу.

      Ширина считается по содержимому, а не берётся из макета оригинала.
      Самая широкая строка — подпись 132 плюс зазор 6 плюс управление, которое
      шире 360 не растёт; шаги стука со своими полями укладываются в тот же
      предел. Отсюда потолок строки 560, а ширина окна — он же плюс сайдбар 160
      и отступы полей. Прежние 940 при потолке 760 давали у правого края каждой
      строки две с лишним сотни точек пустоты: окно читалось не просторным, а
      сломанным.
  -->

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="160" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Боковой список разделов. -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
      <ListBox Classes="nav grouped"
               ItemsSource="{Binding Sections}"
               SelectedValue="{Binding Section}"
               SelectedValueBinding="{ReflectionBinding Kind}"
               Background="Transparent"
               BorderThickness="0"
               Margin="6,8,6,8">

        <ListBox.ItemTemplate>
          <!--
              Заголовок группы рисует сама строка, которая группу открывает
              (как в WPF-шаблоне строки): у первой группы заголовка нет.
          -->
          <DataTemplate x:DataType="admin:AdminSectionItem">
            <StackPanel>
              <TextBlock Text="{Binding Group}"
                         Margin="0,10,0,6"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         IsVisible="{Binding Group, Converter={x:Static theme:Converters.Present}}" />
              <StackPanel Orientation="Horizontal">
                <theme:Icon Glyph="{Binding Glyph}" Size="16" VerticalAlignment="Center"
                            Foreground="{Binding $parent[ListBoxItem].Foreground}" />
                <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Открытый раздел и полоса низа. -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ScrollViewer Grid.Row="0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="12,12,12,0">
        <!--
            Содержимое тянется на всю ширину, а `RowMaxWidth` держит его
            предел. Прежде здесь стояла жёсткая ширина с прижимом влево, и
            окно, у которого под содержимое 756 точек, а содержимого на 560,
            получало двести точек пустоты у правого края — так, будто у него
            съехала вёрстка.

            Ряд внутри карточки этим не растягивается: ширину управления в нём
            держит собственный предел (см. `SettingsRow`), и «Отображаемое имя»
            не превращается в поле во весь экран.
        -->
        <Grid HorizontalAlignment="Stretch"
              MaxWidth="420">

          <!-- Раздел «Аккаунт». -->
          <StackPanel IsVisible="{Binding ShowsAccount}">
            <theme:SettingsSection Header="{res:Loc AdminAccountTitle}">
              <theme:SettingsRow Header="{res:Loc AdminAccountUsername}">
                <Border Height="24" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0" Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel"
                           Text="{Binding Username}" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminAccountDisplayName}">
                <Border Height="24" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0" Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel"
                           Text="{Binding DisplayName}" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminAccountPassword}">
                <Border Height="24" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0" Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel" PasswordChar="●" x:Name="SipPasswordField"
                               VerticalContentAlignment="Center"
                               Background="Transparent"
                               BorderThickness="0"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               CaretBrush="{DynamicResource TextPrimaryBrush}"
                               TextChanged="OnSipPasswordChanged" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc AdminAccountPasswordSet}"
                                  IsVisible="{Binding HasSipPassword}" />
              <theme:SettingsNote Text="{res:Loc AdminAccountPasswordNone}"
                                  IsAlarming="True"
                                  IsVisible="{Binding !HasSipPassword}" />
              <theme:SettingsNote Text="{res:Loc AdminAccountPasswordNote}" />
            </theme:SettingsSection>
          </StackPanel>

          <!-- Раздел «АТС». -->
          <StackPanel IsVisible="{Binding ShowsPbx}">
            <theme:SettingsSection Header="{res:Loc AdminPbxTitle}">
              <theme:SettingsRow Header="{res:Loc AdminPbxOffice}">
                <Border Height="24" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0" Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel"
                           Text="{Binding OfficeAddress}" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminPbxRemote}">
                <Border Height="24" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0" Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel"
                           Text="{Binding RemoteAddress}" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminPbxPort}">
                <Border Height="24" Width="90" HorizontalAlignment="Left" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                        Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel"
                           Text="{Binding Port}" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminPbxTransport}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="segment" GroupName="Transport" Content="UDP"
                               IsChecked="{Binding Transport, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Udp}" />
                  <RadioButton Classes="segment" GroupName="Transport" Content="TCP"
                               IsChecked="{Binding Transport, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Tcp}" />
                  <RadioButton Classes="segment" GroupName="Transport" Content="TLS"
                               IsChecked="{Binding Transport, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Tls}" />
                </StackPanel>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminPbxExpiry}">
                <Border Height="24" Width="90" HorizontalAlignment="Left" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                        Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel"
                           Text="{Binding RegistrationExpirySeconds}" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc AdminPbxAddressNote}" />
            </theme:SettingsSection>

            <!--
                Стук по портам. Механизм связности, а не защиты, — и подпись под
                разделом говорит об этом прямо: назвать его «защищённым
                подключением» значит однажды объяснять, почему разговор всё-таки
                прочитали.
            -->
            <theme:SettingsSection Header="{res:Loc AdminKnockTitle}">
              <theme:SettingsNote Text="{res:Loc AdminKnockNote}" />

              <ItemsControl ItemsSource="{Binding KnockSteps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="settings:PortKnockStepSetting">
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Border Grid.Column="0" Height="24" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                              Background="{DynamicResource ControlHoverBrush}">
                        <TextBox Classes="panel"
                                 Text="{Binding Host}"
                                 Tag="{res:Loc AdminKnockHost}" />
                      </Border>

                      <Border Grid.Column="2" Height="24" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                              Background="{DynamicResource ControlHoverBrush}">
                        <TextBox Classes="panel"
                                 FontFamily="monospace"
                                 Text="{Binding PayloadBytes}"
                                 Tag="{res:Loc AdminKnockBytes}" />
                      </Border>

                      <Border Grid.Column="4" Height="24" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                              Background="{DynamicResource ControlHoverBrush}">
                        <TextBox Classes="panel"
                                 FontFamily="monospace"
                                 Text="{Binding Count}"
                                 Tag="{res:Loc AdminKnockCount}" />
                      </Border>

                      <Button Grid.Column="6"
                              Classes="settings"
                              Padding="6,2"
                              ToolTip.Tip="{res:Loc AdminMacroRemove}"
                              Click="OnKnockRemoveClick">
                        <theme:Icon Glyph="trash" Size="12" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <theme:SettingsIndented>
                <Button Classes="settings"
                        HorizontalAlignment="Left"
                        Content="{res:Loc AdminKnockAdd}"
                        Click="OnKnockAddClick" />
              </theme:SettingsIndented>

              <theme:SettingsDivider />

              <theme:SettingsRow Header="{res:Loc AdminKnockSpacing}">
                <Border Height="24" Width="90" HorizontalAlignment="Left" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                        Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel"
                           Text="{Binding KnockSpacingSeconds}" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminKnockRepeat}">
                <Border Height="24" Width="90" HorizontalAlignment="Left" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                        Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel"
                           Text="{Binding KnockRepeatIntervalSeconds}" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{Binding KnockSummary}" />
            </theme:SettingsSection>

            <!--
                Проверка сертификата. Видна только при выбранном TLS: на UDP и
                TCP она не значит ничего, а показанная всегда — приглашает
                включить «принимать любой» там, где шифрования нет вовсе.
            -->
            <theme:SettingsSection Header="{res:Loc AdminPbxTlsTitle}"
                                   IsVisible="{Binding IsTls}">
              <theme:SettingsRow Header="{res:Loc AdminPbxTlsFingerprint}">
                <Border Height="24" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                        Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel"
                           IsEnabled="{Binding !AcceptsAnyTlsCertificate}"
                           Text="{Binding PinnedCertificateFingerprint}" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc AdminPbxTlsFingerprintNote}" />

              <theme:SettingsDivider />

              <CheckBox Classes="switch"
                        Content="{res:Loc AdminPbxTlsAcceptAny}"
                        IsChecked="{Binding AcceptsAnyTlsCertificate}" />

              <theme:SettingsNote Text="{res:Loc AdminPbxTlsAcceptAnyNote}"
                                  IsAlarming="True"
                                  IsVisible="{Binding AcceptsAnyTlsCertificate}" />
            </theme:SettingsSection>

            <theme:SettingsSection Header="{res:Loc AdminPbxFeatureTitle}">
              <theme:SettingsRow Header="{res:Loc AdminPbxTransfer}">
                <Border Height="24" Width="120" HorizontalAlignment="Left" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                        Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel"
                           FontFamily="monospace"
                           Text="{Binding TransferFeatureCode}" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminPbxConference}">
                <Border Height="24" Width="120" HorizontalAlignment="Left" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                        Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel"
                           FontFamily="monospace"
                           Text="{Binding ConferenceFeatureCode}" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc AdminPbxFeatureNote}" />
            </theme:SettingsSection>
          </StackPanel>

          <!-- Раздел «Очереди». -->
          <StackPanel IsVisible="{Binding ShowsQueues}">
            <theme:SettingsSection Header="{res:Loc AdminQueuesTitle}">
              <theme:SettingsNote Text="{res:Loc AdminQueuesNote}" />

              <ItemsControl ItemsSource="{Binding Queues}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="settings:QueueSetting">
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Border Grid.Column="0" Height="24" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                              Background="{DynamicResource ControlHoverBrush}">
                        <TextBox Classes="panel"
                                 FontFamily="monospace"
                                 Text="{Binding Number}"
                                 Tag="{res:Loc AdminQueueNumber}" />
                      </Border>

                      <Border Grid.Column="2" Height="24" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                              Background="{DynamicResource ControlHoverBrush}">
                        <TextBox Classes="panel"
                                 Text="{Binding Title}"
                                 Tag="{res:Loc AdminQueueTitle}" />
                      </Border>

                      <Button Grid.Column="4"
                              Classes="settings"
                              Padding="6,2"
                              ToolTip.Tip="{res:Loc AdminMacroRemove}"
                              Click="OnQueueRemoveClick">
                        <theme:Icon Glyph="trash" Size="12" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <theme:SettingsIndented>
                <Button Classes="settings"
                        HorizontalAlignment="Left"
                        Content="{res:Loc AdminQueueAdd}"
                        Click="OnQueueAddClick" />
              </theme:SettingsIndented>
            </theme:SettingsSection>
          </StackPanel>


          <!-- Раздел «Входящие»: защита приёма вызова (W9). -->
          <StackPanel IsVisible="{Binding ShowsIncoming}">

            <theme:SettingsSection Header="{res:Loc AdminGuardTitle}">
              <!--
                  Выключатель не запирается, даже когда значение приезжает из
                  панели, — решение оригинала. Замок защищал ничего: правка
                  любого управляемого поля живёт до следующей выкладки
                  предустановки, а «Управление» затем и существует, чтобы
                  перенастроить место руками. Сказать правду про судьбу правки
                  при этом надо — её говорит подпись под переключателем.
              -->
              <CheckBox Classes="switch"
                        Content="{res:Loc AdminGuardEnabled}"
                        IsChecked="{Binding Guard.IsEnabled}" />

              <theme:SettingsNote Text="{res:Loc AdminGuardManagedNote}"
                                  IsVisible="{Binding Guard.IsServerManaged}" />

              <theme:SettingsNote Text="{res:Loc AdminGuardOffNote}"
                                  IsAlarming="True"
                                  IsVisible="{Binding Guard.IsGuardOff}" />

              <theme:SettingsNote Text="{res:Loc AdminGuardWhyNote}" />
            </theme:SettingsSection>

            <!--
                Маска мобильных (с 0.1.73). Не под выключателем защиты: номер
                прячется от того, кто смотрит на экран, а защита — от того, кто
                жмёт за человека; одно с другим не связано.
            -->
            <theme:SettingsSection Header="{res:Loc AdminNumbersTitle}">
              <CheckBox Classes="switch"
                        Content="{res:Loc AdminMasksMobileNumbers}"
                        IsChecked="{Binding Guard.MasksMobileNumbers}" />

              <theme:SettingsNote Text="{res:Loc AdminGuardManagedNote}"
                                  IsVisible="{Binding Guard.IsServerManaged}" />

              <theme:SettingsNote Text="{res:Loc AdminMasksMobileNumbersNote}" />
            </theme:SettingsSection>

            <!-- Автоподъём (с 0.1.61, как на macOS). -->
            <theme:SettingsSection Header="{res:Loc AdminAutoAnswerTitle}">
              <RadioButton Classes="segment" GroupName="AutoAnswer"
                           Content="{res:Loc AdminAutoAnswerOff}"
                           IsChecked="{Binding Guard.AutoAnswerOff}" />
              <RadioButton Classes="segment" GroupName="AutoAnswer"
                           Content="{res:Loc AdminAutoAnswerAlways}"
                           IsChecked="{Binding Guard.AutoAnswerAlways}" />
              <RadioButton Classes="segment" GroupName="AutoAnswer"
                           Content="{res:Loc AdminAutoAnswerHeader}"
                           IsChecked="{Binding Guard.AutoAnswerHeader}" />
              <RadioButton Classes="segment" GroupName="AutoAnswer"
                           Content="{res:Loc AdminAutoAnswerList}"
                           IsChecked="{Binding Guard.AutoAnswerList}" />

              <theme:SettingsRow Header="{res:Loc AdminAutoAnswerNumbers}"
                                 Margin="0,8,0,0"
                                 IsVisible="{Binding Guard.AutoAnswerList}">
                <Border CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,4"
                        Background="{DynamicResource ControlBackgroundBrush}">
                  <TextBox Classes="panel"
                           MinHeight="60"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           VerticalContentAlignment="Top"
                           Text="{Binding Guard.AutoAnswerNumbersText, UpdateSourceTrigger=LostFocus}" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc AdminAutoAnswerNote}" />
              <theme:SettingsNote Text="{res:Loc AdminAutoAnswerAlwaysNote}"
                                  IsAlarming="True"
                                  IsVisible="{Binding Guard.AutoAnswerAlways}" />
            </theme:SettingsSection>

            <theme:SettingsSection Header="{res:Loc AdminGuardRandomTitle}"
                                   IsEnabled="{Binding Guard.IsEnabled}">
              <CheckBox Classes="switch"
                        Content="{res:Loc AdminGuardRandomPosition}"
                        IsChecked="{Binding Guard.IsRandomPositionEnabled}" />

              <theme:SettingsRow Header="{res:Loc AdminGuardTuning}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="segment" GroupName="RandomTuning"
                               Content="{res:Loc AdminGuardTuningAuto}"
                               IsChecked="{Binding Guard.TunesRandomnessAutomatically}" />
                  <RadioButton Classes="segment" GroupName="RandomTuning"
                               Content="{res:Loc AdminGuardTuningManual}"
                               IsChecked="{Binding Guard.TunesRandomnessByHand}" />
                </StackPanel>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminGuardMinimumTravel}"
                                 IsEnabled="{Binding Guard.RandomnessSlidersAreEditable}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0" Minimum="0" Maximum="600"
                          IsSnapToTickEnabled="True" TickFrequency="25"
                          VerticalAlignment="Center"
                          Value="{Binding Guard.MinimumTravel}" />
                  <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34"
                             TextAlignment="Right" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="{Binding Guard.MinimumTravel, StringFormat={}{0:F0}}" />
                </Grid>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminGuardScreenMargin}"
                                 IsEnabled="{Binding Guard.RandomnessSlidersAreEditable}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0" Minimum="0" Maximum="200"
                          IsSnapToTickEnabled="True" TickFrequency="8"
                          VerticalAlignment="Center"
                          Value="{Binding Guard.ScreenMargin}" />
                  <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34"
                             TextAlignment="Right" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="{Binding Guard.ScreenMargin, StringFormat={}{0:F0}}" />
                </Grid>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc AdminGuardRandomNote}" />
              <theme:SettingsNote Text="{res:Loc AdminGuardTuningNote}" />
            </theme:SettingsSection>

            <theme:SettingsSection Header="{res:Loc AdminGuardDigitTitle}"
                                   IsEnabled="{Binding Guard.IsEnabled}">
              <CheckBox Classes="switch"
                        Content="{res:Loc AdminGuardDigitEnabled}"
                        IsChecked="{Binding Guard.AsksForDigit}" />

              <theme:SettingsRow Header="{res:Loc AdminGuardTargets}"
                                 IsEnabled="{Binding Guard.AsksForDigit}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0" Minimum="2" Maximum="5"
                          IsSnapToTickEnabled="True" TickFrequency="1"
                          VerticalAlignment="Center"
                          Value="{Binding Guard.TargetCount}" />
                  <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34"
                             TextAlignment="Right" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="{Binding Guard.TargetCount}" />
                </Grid>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc AdminGuardDigitNote}" />
            </theme:SettingsSection>

            <theme:SettingsSection Header="{res:Loc AdminGuardLivenessTitle}"
                                   IsEnabled="{Binding Guard.IsEnabled}">
              <CheckBox Classes="switch"
                        Content="{res:Loc AdminGuardCursor}"
                        IsChecked="{Binding Guard.RequiresCursorMovement}" />

              <theme:SettingsRow Header="{res:Loc AdminGuardTuning}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="segment" GroupName="LivenessTuning"
                               Content="{res:Loc AdminGuardTuningAuto}"
                               IsChecked="{Binding Guard.TunesLivenessAutomatically}" />
                  <RadioButton Classes="segment" GroupName="LivenessTuning"
                               Content="{res:Loc AdminGuardTuningManual}"
                               IsChecked="{Binding Guard.TunesLivenessByHand}" />
                </StackPanel>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminGuardCursorTravel}"
                                 IsEnabled="{Binding Guard.LivenessSlidersAreEditable}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0" Minimum="0" Maximum="200"
                          IsSnapToTickEnabled="True" TickFrequency="10"
                          VerticalAlignment="Center"
                          Value="{Binding Guard.RequiredCursorTravel}" />
                  <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34"
                             TextAlignment="Right" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="{Binding Guard.RequiredCursorTravel, StringFormat={}{0:F0}}" />
                </Grid>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc AdminGuardCursorNote}" />

              <CheckBox Classes="switch"
                        Content="{res:Loc AdminGuardSynthetic}"
                        IsChecked="{Binding Guard.RejectsSyntheticEvents}" />

              <theme:SettingsNote Text="{res:Loc AdminGuardSyntheticNote}" />
            </theme:SettingsSection>

            <theme:SettingsSection Header="{res:Loc AdminGuardCheckTitle}">
              <theme:SettingsIndented>
                <StackPanel Orientation="Horizontal">
                  <Button Classes="settings"
                          Content="{res:Loc AdminGuardCheckShow}"
                          Command="{Binding PreviewDistribution}" />
                  <Button Classes="settings"
                          Margin="6,0,0,0"
                          Content="{res:Loc AdminGuardCheckDeal}"
                          Command="{Binding PreviewDeal}" />
                </StackPanel>
              </theme:SettingsIndented>

              <theme:SettingsNote Text="{res:Loc AdminGuardCheckNote}" />

              <theme:SettingsRow Header="{res:Loc AdminGuardLastCall}"
                                 IsVisible="{Binding LastGuardReport, Converter={x:Static theme:Converters.Present}}">
                <TextBlock Text="{Binding LastGuardReport}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>
            </theme:SettingsSection>
          </StackPanel>
          <!-- Раздел «Обслуживание». -->
          <StackPanel IsVisible="{Binding ShowsMaintenance}">
            <theme:SettingsSection Header="{res:Loc AdminMaintenanceTitle}">
              <CheckBox Classes="switch"
                        Content="{res:Loc AdminMaintenanceLog}"
                        IsChecked="{Binding LogToFile}" />

              <CheckBox Classes="switch"
                        Content="{res:Loc AdminMaintenanceTrace}"
                        IsEnabled="{Binding LogToFile}"
                        IsChecked="{Binding LogsSipTrace}" />

              <theme:SettingsNote Text="{res:Loc AdminMaintenanceNote}" />

              <theme:SettingsDivider />

              <theme:SettingsIndented>
                <Button Classes="settings"
                        HorizontalAlignment="Left"
                        Content="{res:Loc AdminDiagnosticsOpenFolder}"
                        Click="OnOpenFolderClick" />
              </theme:SettingsIndented>
            </theme:SettingsSection>

            <!--
                Сброс — своей плашкой, а не строкой в «Обслуживании» выше.
                Довод из оригинала: иначе в одном ряду оказываются «Открыть
                папку» и «Стереть машину», и человек ищет первое, глядя на
                второе.
            -->
            <theme:SettingsSection Header="{res:Loc AdminResetTitle}">
              <theme:SettingsIndented>
                <StackPanel Orientation="Horizontal">
                  <Button Classes="settings"
                          Content="{res:Loc AdminResetButton}"
                          IsEnabled="{Binding CanResetMachine}"
                          Click="OnResetMachineClick" />

                  <!--
                      Подсказка видна ровно тогда, когда кнопка погашена.
                      Триггером, а не конвертером: встроенный
                      `BooleanToVisibilityConverter` инверсии не умеет, а
                      заводить свой ради одной строки незачем.
                  -->
                  <TextBlock Text="{res:Loc AdminResetInCall}"
                             Margin="8,0,0,0"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             IsVisible="{Binding !CanResetMachine}" />
                </StackPanel>
              </theme:SettingsIndented>

              <theme:SettingsNote Text="{res:Loc AdminResetNote}" />
            </theme:SettingsSection>
          </StackPanel>

          <!--
              Раздел «Поддержка»: связь с панелью.

              Единственный раздел, где кнопки действуют сразу, — см.
              `SupportViewModel`. Поэтому у него и своя модель: «Сохранить» и
              «Отменить» внизу окна к нему не относятся.
          -->
          <Panel IsVisible="{Binding ShowsSupport}">
          <StackPanel DataContext="{Binding Support}"
                      x:DataType="admin:SupportViewModel">
            <theme:SettingsSection Header="{res:Loc AdminSupportTitle}">

              <theme:SettingsRow Header="{res:Loc AdminSupportMachine}">
                <TextBlock Text="{Binding InstallationID}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminSupportPreset}">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                  <Run Text="{Binding PresetName, Mode=OneWay}" />
                  <Run Text=" · " />
                  <Run Text="{res:Loc AdminSupportRevision}" />
                  <Run Text=" " />
                  <Run Text="{Binding AppliedRevision, Mode=OneWay}" />
                </TextBlock>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminSupportLastContact}">
                <TextBlock Text="{Binding LastContact}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminSupportLink}">
                <TextBlock Text="{Binding LinkState}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>

              <theme:SettingsDivider />

              <!-- У машины на связи — «Проверить настройки сейчас»; в оффлайне
                   на её месте «Вернуться в онлайн». Две кнопки рядом читались
                   бы как два разных способа сделать одно. -->
              <theme:SettingsIndented>
                <Grid>
                  <Button Classes="settings"
                          HorizontalAlignment="Left"
                          Content="{res:Loc AdminSupportCheckNow}"
                          Command="{Binding CheckNow}"
                          IsVisible="{Binding IsOnline}" />
                  <Button Classes="settings"
                          HorizontalAlignment="Left"
                          Content="{res:Loc SupportReturnOnline}"
                          Command="{Binding ReturnOnline}"
                          IsVisible="{Binding IsOffline}" />
                </Grid>
              </theme:SettingsIndented>

              <theme:SettingsNote Text="{res:Loc SupportReturnOnlineNote}"
                                  IsVisible="{Binding IsOffline}" />

              <theme:SettingsNote Text="{Binding Report}"
                                  IsVisible="{Binding HasReport}" />
            </theme:SettingsSection>
          </StackPanel>
          </Panel>

          <!-- Раздел «Клавиши». -->
          <StackPanel IsVisible="{Binding ShowsMacros}">
            <theme:SettingsSection Header="{res:Loc AdminMacrosTitle}">
              <theme:SettingsNote Text="{res:Loc AdminMacrosNote}" />

              <ItemsControl ItemsSource="{Binding Macros}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="settings:MacroSetting">
                    <Border Margin="0,3"
                            Padding="8"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{DynamicResource ControlHoverBrush}">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <Border Grid.Column="0"
                                  Height="24"
                                  CornerRadius="{StaticResource ControlCornerRadius}"
                                  Padding="6,0"
                                  Background="{DynamicResource SurfaceBrush}">
                            <TextBox Classes="panel"
                                     Text="{Binding Title}"
                                     Tag="{res:Loc AdminMacroTitle}" />
                          </Border>

                          <Border Grid.Column="2"
                                  Height="24"
                                  CornerRadius="{StaticResource ControlCornerRadius}"
                                  Padding="6,0"
                                  Background="{DynamicResource SurfaceBrush}">
                            <TextBox Classes="panel"
                                     FontFamily="monospace"
                                     Text="{Binding Sequence}"
                                     Tag="{res:Loc AdminMacroSequence}" />
                          </Border>

                          <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Classes="settings"
                                    Padding="6,2"
                                    Content="↑"
                                    ToolTip.Tip="{res:Loc AdminMacroUp}"
                                    Click="OnMacroUpClick" />
                            <Button Classes="settings"
                                    Margin="4,0,0,0"
                                    Padding="6,2"
                                    Content="↓"
                                    ToolTip.Tip="{res:Loc AdminMacroDown}"
                                    Click="OnMacroDownClick" />
                            <Button Classes="settings"
                                    Margin="4,0,0,0"
                                    Padding="6,2"
                                    ToolTip.Tip="{res:Loc AdminMacroRemove}"
                                    Click="OnMacroRemoveClick">
                              <theme:Icon Glyph="trash" Size="12" />
                            </Button>
                          </StackPanel>
                        </Grid>

                        <CheckBox Classes="switch"
                                  Margin="0,6,0,0"
                                  Content="{res:Loc AdminMacroTransfers}"
                                  IsChecked="{Binding TransfersCall}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <theme:SettingsIndented>
                <Button Classes="settings"
                        HorizontalAlignment="Left"
                        Content="{res:Loc AdminMacroAdd}"
                        Click="OnMacroAddClick" />
              </theme:SettingsIndented>

              <theme:SettingsNote Text="{res:Loc AdminMacroTransfersNote}" />
            </theme:SettingsSection>

            <theme:SettingsSection Header="{res:Loc AdminMacroLayout}">
              <theme:SettingsRow Header="{res:Loc AdminMacroColumns}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="segment" GroupName="Columns" Content="2"
                               IsChecked="{Binding MacroColumns, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=2}" />
                  <RadioButton Classes="segment" GroupName="Columns" Content="3"
                               IsChecked="{Binding MacroColumns, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=3}" />
                  <RadioButton Classes="segment" GroupName="Columns" Content="4"
                               IsChecked="{Binding MacroColumns, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=4}" />
                </StackPanel>
              </theme:SettingsRow>

              <CheckBox Classes="switch"
                        Content="{res:Loc AdminMacroHeightAuto}"
                        IsChecked="{Binding !MacroHeightIsManual}" />

              <theme:SettingsRow Header="{res:Loc AdminMacroHeight}"
                                 IsEnabled="{Binding MacroHeightIsManual}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0"
                          Minimum="44" Maximum="96"
                          IsSnapToTickEnabled="True" TickFrequency="2"
                          VerticalAlignment="Center"
                          Value="{Binding MacroHeight}" />
                  <TextBlock Grid.Column="1"
                             Margin="6,0,0,0"
                             MinWidth="34"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="{Binding MacroHeight}" />
                </Grid>
              </theme:SettingsRow>
            </theme:SettingsSection>
          </StackPanel>

          <!-- Раздел «История». -->
          <StackPanel IsVisible="{Binding ShowsHistory}">
            <theme:SettingsSection Header="{res:Loc AdminHistoryTitle}">
              <CheckBox Classes="switch"
                        Content="{res:Loc AdminHistoryEnabled}"
                        IsChecked="{Binding HistoryIsEnabled}" />

              <theme:SettingsRow Header="{res:Loc AdminHistoryAge}"
                                 IsEnabled="{Binding HistoryIsEnabled}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0"
                          Minimum="1" Maximum="365"
                          IsSnapToTickEnabled="True" TickFrequency="1"
                          VerticalAlignment="Center"
                          Value="{Binding HistoryAgeInDays}" />
                  <TextBlock Grid.Column="1"
                             Margin="6,0,0,0"
                             MinWidth="34"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="{Binding HistoryAgeInDays}" />
                </Grid>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc AdminHistoryNote}" />
            </theme:SettingsSection>
          </StackPanel>

          <!-- Раздел «Доступ». -->
          <StackPanel IsVisible="{Binding ShowsAccess}">
            <theme:SettingsSection Header="{res:Loc AdminAccessTitle}">
              <theme:SettingsNote Text="{res:Loc AdminAccessProtected}"
                                  IsVisible="{Binding IsProtected}" />
              <theme:SettingsNote Text="{res:Loc AdminAccessOpen}"
                                  IsAlarming="True"
                                  IsVisible="{Binding !IsProtected}" />

              <theme:SettingsRow Header="{res:Loc AdminAccessNewPassword}">
                <Border Height="24" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                        Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel" PasswordChar="●" x:Name="NewPasswordField"
                               VerticalContentAlignment="Center"
                               Background="Transparent"
                               BorderThickness="0"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               CaretBrush="{DynamicResource TextPrimaryBrush}"
                               TextChanged="OnNewPasswordChanged" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminAccessRepeatPassword}">
                <Border Height="24" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0"
                        Background="{DynamicResource ControlHoverBrush}">
                  <TextBox Classes="panel" PasswordChar="●" x:Name="RepeatedPasswordField"
                               VerticalContentAlignment="Center"
                               Background="Transparent"
                               BorderThickness="0"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               CaretBrush="{DynamicResource TextPrimaryBrush}"
                               TextChanged="OnRepeatedPasswordChanged" />
                </Border>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc AdminAccessMismatch}"
                                  IsAlarming="True"
                                  IsVisible="{Binding PasswordsDiffer}" />

              <theme:SettingsIndented>
                <StackPanel Orientation="Horizontal">
                  <Button Classes="settings"
                          Content="{res:Loc AdminAccessSet}"
                          IsEnabled="{Binding CanSetPassword}"
                          Click="OnSetPasswordClick" />
                  <Button Classes="settings"
                          Margin="6,0,0,0"
                          Content="{res:Loc AdminAccessRemove}"
                          IsEnabled="{Binding IsProtected}"
                          Click="OnRemovePasswordClick" />
                </StackPanel>
              </theme:SettingsIndented>

              <theme:SettingsNote Text="{res:Loc AdminAccessApplied}" />
            </theme:SettingsSection>
          </StackPanel>

          <!-- Раздел «Диагностика». -->
          <StackPanel IsVisible="{Binding ShowsDiagnostics}">
            <theme:SettingsSection Header="{res:Loc AdminDiagnosticsTitle}">
              <theme:SettingsRow Header="{res:Loc SupportVersion}">
                <TextBlock Text="{Binding Version}" Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminDiagnosticsSettingsPath}">
                <TextBlock Text="{Binding SettingsPath}"
                           TextWrapping="Wrap"
                           FontFamily="monospace"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>

              <theme:SettingsIndented>
                <Button Classes="settings"
                        HorizontalAlignment="Left"
                        Content="{res:Loc AdminDiagnosticsOpenFolder}"
                        Click="OnOpenFolderClick" />
              </theme:SettingsIndented>

              <theme:SettingsNote Text="{res:Loc AdminDiagnosticsNote}" />

              <!--
                  Обновления: такт двухчасовой, а разбирают неисправность здесь
                  и сейчас. Кнопка есть ровно поэтому.
              -->
              <StackPanel DataContext="{Binding Updates}"
                          x:DataType="admin:UpdatesViewModel"
                          IsVisible="{Binding Converter={x:Static theme:Converters.Present}}">
                <theme:SettingsDivider />

                <theme:SettingsIndented>
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="settings"
                            Content="{res:Loc AdminDiagnosticsCheckUpdates}"
                            Command="{Binding CheckNow}" />

                    <Button Classes="settings"
                            Margin="6,0,0,0"
                            Content="{res:Loc AdminDiagnosticsInstallUpdate}"
                            Command="{Binding Install}"
                            IsVisible="{Binding IsReady}" />
                  </StackPanel>
                </theme:SettingsIndented>

                <theme:SettingsNote Text="{Binding Status}"
                                    IsVisible="{Binding HasStatus}" />
              </StackPanel>
            </theme:SettingsSection>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!--
          Полоса низа: «Сохранить» и «Отменить». Здесь они есть, а в
          менеджерских настройках их нет и быть не может — там правка
          применяется сразу. Разница по существу: менеджер меняет громкость
          себе, администратор — рабочее место целиком.
      -->
      <Border Grid.Row="1" Padding="12,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!--
              Значок и две строки, а не одна точка. Точка говорит «что-то не
              так», но не говорит что: после «Сохранить» она молча гасла, окно
              оставалось открытым, и нажатие читалось как не сделавшее ничего.
          -->
          <Panel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
            <theme:Icon Glyph="lock.shield.fill" Size="16"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        IsVisible="{Binding !IsDirty}" />
            <theme:Icon Glyph="exclamationmark.triangle" Size="16"
                        Foreground="{DynamicResource UnsavedBrush}"
                        IsVisible="{Binding IsDirty}" />
          </Panel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding SaveStateTitle}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding SaveStateBody}"
                       Margin="0,1,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Classes="settings"
                    Content="{res:Loc AdminRevert}"
                    IsEnabled="{Binding IsDirty}"
                    Click="OnRevertClick" />
            <Button Classes="settings"
                    Margin="6,0,0,0"
                    Content="{res:Loc AdminSave}"
                    IsEnabled="{Binding IsDirty}"
                    Click="OnSaveClick" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
