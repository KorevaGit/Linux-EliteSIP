<Window x:Class="EliteSIP.App.FirstRun.FirstRunWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="using:EliteSIP.App.Theme" xmlns:res="using:EliteSIP.App.Resources" xmlns:firstrun="using:EliteSIP.App.FirstRun" x:DataType="firstrun:FirstRunViewModel" xmlns:settings="using:EliteSIP.App.Settings" Title="{res:Loc FirstRunTitle}" Width="560" Height="440" CanResize="False" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">

  <Grid Margin="18,8,18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
      <RowDefinition Height="48" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Classes="wizard-step" Classes.current="{Binding ShowsConnection}" Text="{res:Loc AdminConnection}">

      </TextBlock>
      <theme:Icon Grid.Column="1" Glyph="settings.arrow-right" Size="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBlock Grid.Column="2" Classes="wizard-step" Classes.current="{Binding ShowsAppearance}" Text="{res:Loc SectionAppearance}" HorizontalAlignment="Center">

      </TextBlock>
      <theme:Icon Grid.Column="3" Glyph="settings.arrow-right" Size="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBlock Grid.Column="4" Classes="wizard-step" Classes.current="{Binding ShowsFinale}" Text="{res:Loc FirstRunFinaleTitle}" HorizontalAlignment="Right">

      </TextBlock>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="132" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" SelectedValue="{Binding Language}" SelectedValueBinding="{ReflectionBinding Tag}" VerticalAlignment="Center" Height="30" IsVisible="{Binding ShowsConnection}" ToolTip.Tip="{res:Loc AppearanceLanguage}">
        <ComboBoxItem Tag="{x:Static settings:LanguageSetting.System}" Content="{res:Loc AppearanceLanguageSystem}" />
        <ComboBoxItem Tag="{x:Static settings:LanguageSetting.Russian}" Content="Русский" />
        <ComboBoxItem Tag="{x:Static settings:LanguageSetting.English}" Content="English" />
      </ComboBox>
    </Grid>
    <ScrollViewer Grid.Row="2" x:Name="StepScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <StackPanel IsVisible="{Binding ShowsConnection}">
          <Border Background="{DynamicResource ControlPressedBrush}" CornerRadius="9" Padding="3" Margin="0,3,0,10">
            <UniformGrid Columns="2">
              <RadioButton Classes="segment" Content="{res:Loc WizardSpark}" IsChecked="{Binding ShowsPairing, Mode=OneWay}" Click="OnSparkSetupClick" />
              <RadioButton Classes="segment" Content="{res:Loc WizardManual}" IsChecked="{Binding ShowsUser, Mode=OneWay}" IsEnabled="{Binding !IsPaired}" Click="OnManualSetupClick" />
            </UniformGrid>
          </Border>
          <StackPanel IsVisible="{Binding ShowsPairing}">
            <Border Classes="card" IsVisible="{Binding !IsPaired}">
              <StackPanel>
                <Grid IsVisible="{Binding HasPairCode}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Background="White" CornerRadius="7" Padding="4">
                    <Image Source="{Binding PairQr, Converter={x:Static firstrun:QrImageConverter.Instance}}" Width="112" Height="112" RenderOptions.BitmapInterpolationMode="None" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{res:Loc FirstRunPairCodeLabel}" Classes="wizard-label" />
                    <TextBlock Text="{Binding PairCode}" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,8" />
                    <Button Classes="settings" HorizontalAlignment="Left" Click="OnNewCodeClick">
                      <StackPanel Orientation="Horizontal">
                        <theme:Icon Glyph="settings.refresh-cw" Size="14" />
                        <TextBlock Text="{res:Loc FirstRunPairNewCode}" Margin="6,0,0,0" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
                <StackPanel IsVisible="{Binding HasNoChannel}" Margin="0,6">
                  <theme:Icon Glyph="settings.cloud" Size="28" HorizontalAlignment="Center" />
                  <TextBlock Text="{res:Loc FirstRunKeyNoChannel}" TextWrapping="Wrap" TextAlignment="Center" Margin="8,10,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                  <theme:Icon Glyph="settings.monitor" Size="18" />
                  <TextBlock Text="{res:Loc SettingsThisPc}" Margin="6,0,12,0" Classes="wizard-label" VerticalAlignment="Center" />
                  <theme:Icon Glyph="settings.arrow-right" Size="14" VerticalAlignment="Center" />
                  <theme:Icon Glyph="settings.cloud" Size="18" Margin="12,0,6,0" />
                  <TextBlock Text="Spark" Classes="wizard-label" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding IsPaired}">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{res:Loc WizardPaired}" Foreground="{DynamicResource StatusRegisteredBrush}" FontSize="12" />
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.monitor" Size="16" />
                    <TextBlock Text="{res:Loc WorkPlace}" Margin="7,0,0,0" Classes="wizard-label" />
                  </StackPanel>
                </DockPanel>
                <Grid Margin="0,21">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ProfileNumber}" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProfileLabel}" FontSize="17" TextWrapping="Wrap" />
                    <TextBlock Text="{res:Loc WizardFromSpark}" Classes="wizard-label" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal">
                  <theme:Icon Glyph="settings.cloud" Size="17" />
                  <TextBlock Text="Spark" Margin="6,0,15,0" Classes="wizard-label" />
                  <theme:Icon Glyph="settings.arrow-left-right" Size="16" Foreground="{DynamicResource StatusRegisteredBrush}" />
                  <TextBlock Text="{res:Loc SettingsThisPc}" Classes="wizard-label" Margin="15,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding PairStatus}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" IsVisible="{Binding HasPairStatus}">

            </TextBlock>
          </StackPanel>
          <Border Padding="12" Classes="card" IsVisible="{Binding ShowsUser}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="24" />
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="{res:Loc AdminAccountUsername}" Classes="wizard-label" />
                <Border Classes="wizard-field">
                  <TextBox Classes="panel" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{res:Loc AdminProfileLabel}" Classes="wizard-label" />
                <Border Classes="wizard-field">
                  <TextBox Classes="panel" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Row="1">
                <TextBlock Text="{res:Loc WorkPbxAddress}" Classes="wizard-label" />
                <Border Classes="wizard-field">
                  <TextBox Classes="panel" Text="{Binding OfficeAddress, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="{res:Loc AdminAccountPassword}" Classes="wizard-label" />
                <Border Classes="wizard-field">
                  <TextBox x:Name="SipPasswordField" PasswordChar="●" Classes="panel" TextChanged="OnSipPasswordChanged" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                <theme:Icon Glyph="settings.lock-keyhole" Size="14" />
                <TextBlock Text="{res:Loc WizardAdminOptional}" Classes="wizard-label" Margin="6,0,0,0" />
              </StackPanel>
              <StackPanel Grid.Row="3">
                <TextBlock Text="{res:Loc AdminAccessNewPassword}" Classes="wizard-label" />
                <Border Classes="wizard-field">
                  <TextBox x:Name="AdminPasswordField" PasswordChar="●" Classes="panel" TextChanged="OnAdminPasswordChanged" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Row="3" Grid.Column="2">
                <TextBlock Text="{res:Loc AdminAccessRepeatPassword}" Classes="wizard-label" />
                <Border Classes="wizard-field">
                  <TextBox x:Name="RepeatedAdminPasswordField" PasswordChar="●" Classes="panel" TextChanged="OnRepeatedAdminPasswordChanged" />
                </Border>
              </StackPanel>
              <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="{res:Loc AdminAccessMismatch}" FontSize="11" Foreground="{DynamicResource CautionBrush}" TextWrapping="Wrap" IsVisible="{Binding AdminPasswordsDiffer}" />
            </Grid>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowsAppearance}">
          <Border Classes="card">
            <StackPanel>
              <UniformGrid Columns="3">
                <RadioButton Classes="tile" Tag="System" GroupName="WizardTheme" Content="{res:Loc AppearanceSystem}" IsChecked="{Binding Theme, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=System}" />
                <RadioButton Classes="tile" Tag="Light" GroupName="WizardTheme" Content="{res:Loc AppearanceLight}" IsChecked="{Binding Theme, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Light}" />
                <RadioButton Classes="tile" Tag="Dark" GroupName="WizardTheme" Content="{res:Loc AppearanceDark}" IsChecked="{Binding Theme, Converter={x:Static theme:Converters.EnumToBool}, ConverterParameter=Dark}" />
              </UniformGrid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,17,0,3">
                <theme:Icon Glyph="settings.panels-top-left" Size="16" />
                <TextBlock Text="{res:Loc WizardThemeLive}" Classes="wizard-label" Margin="7,0,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowsFinale}">
          <Grid Margin="4,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="26" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="9" BoxShadow="0 3 7 0 #16000000">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <theme:Icon Glyph="settings.crown-split" Size="13" />
                  <TextBlock Text="EliteSIP" FontSize="11" Margin="6,0,0,0" />
                </StackPanel>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="6,3" HorizontalAlignment="Left" MaxWidth="158">
                  <TextBlock FontSize="10" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding ProfileNumber, Mode=OneWay}" />
                    <Run Text=" " />
                    <Run Text="{Binding ProfileLabel, Mode=OneWay}" />
                  </TextBlock>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="7" Padding="9,13" Margin="0,7">
                  <TextBlock Text="{res:Loc PanelNumberPlaceholder}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
                <UniformGrid Columns="2" Margin="0,0,0,6">
                  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="3,10" Margin="0,0,3,0">
                    <theme:Icon Glyph="settings.mic" Size="12" />
                  </Border>
                  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="3,10" Margin="3,0,0,0">
                    <theme:Icon Glyph="settings.headset" Size="12" />
                  </Border>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,0,0,6">
                  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Height="39" Margin="0,0,3,0" />
                  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Height="39" Margin="3,0,0,0" />
                </UniformGrid>
                <Border Background="{DynamicResource AnswerFillBrush}" CornerRadius="6" Padding="5,9">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <theme:Icon Glyph="phone.fill" Size="12" Foreground="White" />
                    <TextBlock Text="{res:Loc PanelCall}" FontSize="11" Foreground="White" Margin="6,0,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="{res:Loc WorkPlace}" Classes="wizard-label" />
              <TextBlock Text="{Binding ProfileNumber}" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,3" />
              <TextBlock Text="{Binding ProfileLabel}" FontSize="16" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ProfileSource}" Classes="wizard-label" Margin="0,17,0,0" />
              <TextBlock Text="{res:Loc WizardLaunchNote}" Classes="wizard-label" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Row="3" Margin="0,8,18,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding FooterNote}" Classes="wizard-label" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
      <Button Grid.Column="1" Classes="settings" Content="{res:Loc FirstRunBack}" IsEnabled="{Binding CanReturn}" Click="OnBackClick" />
      <Button Grid.Column="3" x:Name="ForwardButton" Classes="settings" IsEnabled="{Binding CanGoForward}" Width="132" Click="OnForwardClick">
        <Panel><TextBlock Text="{res:Loc FirstRunNext}" IsVisible="{Binding !IsLastStep}"/><TextBlock Text="{res:Loc FirstRunFinish}" IsVisible="{Binding IsLastStep}"/></Panel>
      </Button>
    </Grid>
  </Grid>
</Window>
