<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Приложение Linux-версии (W-L5): окна на Avalonia поверх общего
    EliteSIP.App.Core. Модели окон, телефон, линия Spark и настройки — общие;
    здесь только виды, тема и связка с оболочкой Linux (EliteSIP.Platform.Linux)
    и звуком PulseAudio (EliteSIP.Audio.Pulse).

    Переносятся макет и поведение Windows-версии (shared/src/EliteSIP.App), а
    не macOS: отступы, растяжение, скругления, капсула профиля, плитки темы.
    Разметка переписана под Avalonia — стили селекторами и классами вместо
    триггеров, — а числа взяты из WPF-разметки как есть.

    Имя сборки — EliteSIP.App.Linux: под ним App.Core открывает этому
    проекту внутреннее (метрики, размеры значков). Короткое имя исполняемого
    файла в /opt/elitesip, которое зовут ярлык, автозапуск и служба
    (packaging/), даёт пакет — W-L7.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EliteSIP.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Привязки компилируются: опечатка в имени свойства модели — ошибка
      сборки, а не пустое поле на экране, которое заметят через неделю.
    -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest />
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EliteSIP.App.Linux.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Значки — тот же файл, что у Windows-версии (Theme/IconLibrary.cs), и
      стандартный рингтон — тот же WAV.
    -->
    <EmbeddedResource Include="..\..\shared\src\EliteSIP.App\Theme\Icons.xaml" LogicalName="EliteSIP.App.Theme.Icons.xaml" />
    <Content Include="..\..\shared\src\EliteSIP.App\Assets\ringtone.wav" Link="ringtone.wav" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="..\..\shared\src\EliteSIP.App\Assets\AppIcon\icon_256x256.png" Link="Assets/elitesip.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EliteSIP.Platform.Linux\EliteSIP.Platform.Linux.csproj" />
    <ProjectReference Include="..\EliteSIP.Audio.Pulse\EliteSIP.Audio.Pulse.csproj" />
    <ProjectReference Include="..\..\shared\src\EliteSIP.App.Core\EliteSIP.App.Core.csproj" />
  </ItemGroup>

</Project>
