<Project Sdk="Microsoft.NET.Sdk">

  <!-- Локальный проект независимого Linux-клиента. Происхождение: core/ORIGIN.md. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EliteSIP.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Привязки компилируются: опечатка в имени свойства модели — ошибка
      сборки, а не пустое поле на экране, которое заметят через неделю.
    -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest />

    <!--
      Рисованная рамка окон на X11 в Avalonia 12.1 помечена экспериментальной;
      почему она всё равно нужна и как её выключить — Program.DrawsOwnFrame.
    -->
    <NoWarn>$(NoWarn);AVALONIA_X11_CSD;AVALONIA_X11_FORCE_CSD</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EliteSIP.App.Linux.Tests" />
    <InternalsVisibleTo Include="EliteSIP.TrayProbe" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Значки — тот же файл, что у Windows-версии (Theme/IconLibrary.cs), и
      стандартный рингтон — тот же WAV, смайлики — тот же emoji.pak.
    -->
    <EmbeddedResource Include="..\..\core\src\EliteSIP.App\Theme\Icons.xaml" LogicalName="EliteSIP.App.Theme.Icons.xaml" />
    <EmbeddedResource Include="..\..\core\src\EliteSIP.App\Theme\Icons.Settings.xaml" LogicalName="EliteSIP.App.Theme.Icons.Settings.xaml" />
    <Content Include="..\..\core\src\EliteSIP.App\Assets\ringtone.wav" Link="ringtone.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\core\src\EliteSIP.App\Assets\emoji.pak" Link="emoji.pak" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="..\..\core\src\EliteSIP.App\Assets\AppIcon\icon_256x256.png" Link="Assets/elitesip.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EliteSIP.Platform.Linux\EliteSIP.Platform.Linux.csproj" />
    <ProjectReference Include="..\EliteSIP.Audio.Pulse\EliteSIP.Audio.Pulse.csproj" />
    <ProjectReference Include="..\..\core\src\EliteSIP.App.Core\EliteSIP.App.Core.csproj" />
  </ItemGroup>

  <!-- Ревизия независимого Linux-репозитория; архив исходников не требует Git. -->
  <Target Name="StampSourceRevision" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <LinuxSourceRevision>source-archive</LinuxSourceRevision>
    </PropertyGroup>
    <Exec Condition="Exists('$(MSBuildThisFileDirectory)../../.git')"
          Command="git -C &quot;$(MSBuildThisFileDirectory)../..&quot; rev-parse --short HEAD"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitSourceRevision" />
      <Output TaskParameter="ExitCode" PropertyName="GitSourceRevisionExit" />
    </Exec>
    <PropertyGroup Condition="'$(GitSourceRevisionExit)' == '0'">
      <LinuxSourceRevision>$(GitSourceRevision)</LinuxSourceRevision>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SourceRevision</_Parameter1>
        <_Parameter2>$(LinuxSourceRevision)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
