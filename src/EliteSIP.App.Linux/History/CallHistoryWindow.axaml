<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="using:EliteSIP.App.Theme" xmlns:history="using:EliteSIP.App.History" xmlns:historycore="using:EliteSIP.App.History" xmlns:res="using:EliteSIP.App.Resources" xmlns:calls="using:EliteSIP.CallHistory" x:Class="EliteSIP.App.History.CallHistoryWindow" x:DataType="historycore:CallHistoryViewModel" Width="720" Height="480" MinWidth="640" MinHeight="380" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">

  <!-- Linux adaptation of Windows GraphiteHistory; calendar stays flat. -->
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
      <Border HorizontalAlignment="Left" Background="{DynamicResource HistoryFilterBackgroundBrush}" CornerRadius="10"><ItemsControl ItemsSource="{Binding Filters}" HorizontalAlignment="Left">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="historycore:HistoryFilterItem">
            <RadioButton Classes="history-filter" GroupName="HistoryFilter" Tag="{Binding Filter}" IsCheckedChanged="OnFilterChosen">
              <RadioButton.IsChecked>
                <MultiBinding Converter="{x:Static history:HistoryConverters.Equality}" Mode="OneWay">
                  <Binding Path="Filter"/>
                  <Binding Path="$parent[ItemsControl].DataContext.Filter"/>
                </MultiBinding>
              </RadioButton.IsChecked>
              <StackPanel Orientation="Horizontal">
                <history:OutcomeBadge Classes.incoming="{Binding IsIncoming}" Classes.missed="{Binding Filter, Converter={x:Static theme:Converters.Equal}, ConverterParameter=Missed}" Classes.all="{Binding Filter, Converter={x:Static theme:Converters.Equal}, ConverterParameter=All}" Size="16" VerticalAlignment="Center" IsIncoming="{Binding IsIncoming}" IsCompleted="{Binding IsCompleted}" Outcome="{Binding Outcome}"/>
                <TextBlock Text="{Binding Title}" Margin="4,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl></Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,4,0" Grid.Column="1">
        <Button x:Name="CalendarButton" AutomationProperties.AutomationId="CalendarButton" AutomationProperties.Name="{res:Loc HistoryPickDay}" ToolTip.Tip="{res:Loc HistoryPickDay}" Classes="surface history-toolbar" MinWidth="100" Classes.bold="{Binding Calendar.HasSelectedDay}" Click="OnCalendarClick">
          <StackPanel Orientation="Horizontal">
            <theme:Icon Glyph="calendar" Size="16" VerticalAlignment="Center"/>
            <TextBlock Text="{res:Loc HistoryAllDaysLabel}" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding !Calendar.HasSelectedDay}"/><TextBlock Text="{Binding Calendar.SelectedDayTitle}" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Calendar.HasSelectedDay}"/>
          </StackPanel>
        </Button>
        <Button Classes="surface history-toolbar" Width="32" Padding="0" Margin="4,0,0,0" ToolTip.Tip="{res:Loc HistoryAllDays}" Click="OnClearDayClick" IsVisible="{Binding Calendar.HasSelectedDay}">
          <theme:Icon Glyph="arrow.counterclockwise" Size="18"/>
        </Button>
      </StackPanel>

      <Popup x:Name="CalendarPopup" PlacementTarget="{Binding #CalendarButton}" Placement="Bottom" IsLightDismissEnabled="True" Opened="OnCalendarOpened">
        <Border Name="CalendarSurface" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="12" Padding="12" DataContext="{Binding Calendar}" x:DataType="historycore:HistoryCalendar">
          <StackPanel>
            <Grid>
              <Button Classes="calendar-nav" HorizontalAlignment="Left" Content="‹" FontSize="17" IsEnabled="{Binding CanShowPreviousMonth}" Click="OnPreviousMonthClick"/>

              <TextBlock Text="{Binding MonthTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>

              <Button Classes="calendar-nav" HorizontalAlignment="Right" Content="›" FontSize="17" IsEnabled="{Binding CanShowNextMonth}" Click="OnNextMonthClick"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding WeekdayTitles}" Margin="0,6,0,2">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" Width="28" FontSize="12" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Weeks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="historycore:CalendarWeek">
                  <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="7"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="historycore:CalendarDay">
                        <Button Width="28" Height="28" Classes="day" Classes.selected="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" Click="OnDayClick">
                          <StackPanel>
                            <TextBlock Text="{Binding Number}" FontSize="13" TextAlignment="Center"/>
                            <Ellipse Width="4" Height="4" Margin="0,1,0,0" HorizontalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasCalls}"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Popup>
      <Button Name="SnapshotButton" HorizontalAlignment="Right" Classes="surface history-toolbar" Width="40" Padding="0" Click="OnSnapshotClick" IsEnabled="{Binding HasRecords}" ToolTip.Tip="{res:Loc HistorySnapshot}" Grid.Column="2">
        <theme:Icon Glyph="camera.fill" Size="16" VerticalAlignment="Center"/>
      </Button>
    </Grid>
    <Border Grid.Row="2" x:Name="ListSurface" Background="{DynamicResource CallFieldBrush}" CornerRadius="12" BoxShadow="0 3 9 0 #29000000" ClipToBounds="True">
      <Grid>
        <TextBlock Text="{res:Loc HistoryEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsEmpty}"/>

        <ListBox x:Name="HistoryList" Classes="history-items" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,6,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsEmpty}">
          <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.DataTemplates>
            <DataTemplate DataType="historycore:HistoryDay" x:DataType="historycore:HistoryDay">
              <TextBlock Text="{Binding Title}" Margin="14,18,14,6" FontSize="17" FontWeight="SemiBold"/>
            </DataTemplate>
            <DataTemplate DataType="calls:CallRecord" x:DataType="calls:CallRecord">
                        <Border Classes="history-record" Margin="14,0" Padding="0,9" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1"><Grid MinHeight="48">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="112"/>
                          </Grid.ColumnDefinitions>

                          <history:OutcomeBadge Classes.incoming="{Binding Converter={x:Static history:HistoryConverters.IsIncoming}}" Classes.missed="{Binding IsMissed}" Grid.Column="0" Size="40" VerticalAlignment="Center" Outcome="{Binding Outcome}" IsCompleted="{Binding IsAnswered}" IsIncoming="{Binding Converter={x:Static history:HistoryConverters.IsIncoming}}"/>

                          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                              <TextBlock.Text>
                                <MultiBinding Converter="{x:Static history:HistoryConverters.CallTitle}">
                                  <Binding/>
                                  <Binding Path="$parent[Window].DataContext.OwnNumber"/>
                                  <Binding Path="$parent[Window].DataContext.MasksMobileNumbers"/>
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}">
                              <TextBlock.Text>
                                <MultiBinding Converter="{x:Static history:HistoryConverters.CallSubtitle}">
                                  <Binding/>
                                  <Binding Path="$parent[Window].DataContext.OwnNumber"/>
                                  <Binding Path="$parent[Window].DataContext.MasksMobileNumbers"/>
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                            <TextBlock Text="{Binding StartedAt, Converter={x:Static history:HistoryConverters.CallTime}}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Text="{Binding StartedAt, Converter={x:Static history:HistoryConverters.CallDate}}" Margin="0,4,0,0" FontSize="14" TextAlignment="Center"/>
                          </StackPanel>
                          <TextBlock Grid.Column="3" Text="{Binding Converter={x:Static history:HistoryConverters.OutcomeText}}" VerticalAlignment="Center" TextAlignment="Right" Classes="outcome" Classes.missed="{Binding IsMissed}" Classes.answered="{Binding IsAnswered}"/>
                        </Grid></Border>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
        <Border x:Name="Notice" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" Padding="12,6" CornerRadius="14" IsVisible="False" Background="{DynamicResource SurfaceBrush}">
          <TextBlock x:Name="NoticeText" FontSize="12"/>
        </Border>
      </Grid>
    </Border>
  </Grid>

  <Window.Styles>
    <Style Selector="ListBox.history-items ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><ControlTemplate><ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/></ControlTemplate></Setter>
    </Style>
    <Style Selector="history|OutcomeBadge"><Setter Property="Foreground" Value="{DynamicResource HistoryOutgoingBrush}"/></Style>
    <Style Selector="history|OutcomeBadge.incoming"><Setter Property="Foreground" Value="{DynamicResource OutcomeAnsweredBrush}"/></Style>
    <Style Selector="history|OutcomeBadge.missed"><Setter Property="Foreground" Value="{DynamicResource HistoryMissedBrush}"/></Style>
    <Style Selector="TextBlock.outcome"><Setter Property="FontSize" Value="14"/></Style>
    <Style Selector="TextBlock.outcome.answered"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.history-toolbar.bold">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.day">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.day.selected">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
    </Style>
    <Style Selector="TextBlock.outcome">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.outcome.missed">
      <Setter Property="Foreground" Value="{DynamicResource HistoryMissedBrush}"/>
    </Style>
  </Window.Styles>
</Window>
