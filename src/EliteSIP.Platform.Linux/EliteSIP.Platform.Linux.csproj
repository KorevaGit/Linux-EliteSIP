<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Оболочка Linux (W-L4): всё, что на Windows давала система, а здесь
    собирается из сеанса — одна копия, автозапуск, сон и выключение через
    logind, тема из портала, уведомления, внимание к окну, наличие трея,
    стук через системный ping.

    Окон здесь нет: окна — W-L5 на Avalonia. Этот проект знает только
    сеанс (D-Bus, сигналы, файлы XDG) и X11 там, где окну нужна подсказка
    оконному менеджеру. Реализует интерфейсы EliteSIP.App.Core/Platform и
    IIcmpEcho из SipCore — правило 7 плана переноса.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- LibraryImport к libc и libX11 генерирует небезопасный код. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EliteSIP.Platform.Linux.Tests" />
    <InternalsVisibleTo Include="ShellProbe" />
    <InternalsVisibleTo Include="EliteSIP.App.Linux" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Та же версия, что тянет Avalonia.FreeDesktop 12.1.3: трей Avalonia и
      наши вызовы logind и портала ходят одной библиотекой, и две её версии в
      одном процессе были бы конфликтом сборок.
    -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\src\EliteSIP.App.Core\EliteSIP.App.Core.csproj" />
  </ItemGroup>

</Project>
