<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Звук Linux-версии на PulseAudio API (libpulse). Работает и с PulseAudio, и
    с PipeWire через pipewire-pulse — это и решило выбор (docs/PORT-PLAN.md,
    «Почему PulseAudio API»).

    Здесь движок тракта (PulseVoiceAudioEngine), каталог и слежение за
    устройствами. Всё, что не про устройства, — общий EliteSIP.Audio из
    подмодуля: обработка голоса, пересчёт частоты, регулятор темпа, шина.
    Стенд W-L0А (tools/PulseProbe) ходит через те же привязки, чтобы продукт
    стоял на тех же объявлениях, которыми мерили.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Буферы libpulse приходят сырыми указателями, а обратные вызовы — с
      потока цикла libpulse: указатели на функции и UnmanagedCallersOnly.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PulseProbe" />
    <InternalsVisibleTo Include="EliteSIP.Audio.Pulse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Управляемый декодер MP3 для рингтона: у NAudio он системный (ACM), и на
      Linux его нет. Версия — под NAudio.Core 3.0.1 общего Audio.Signals.
    -->
    <PackageReference Include="NLayer.NAudioSupport" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\src\EliteSIP.Audio\EliteSIP.Audio.csproj" />
    <ProjectReference Include="..\..\shared\src\EliteSIP.Audio.Signals\EliteSIP.Audio.Signals.csproj" />
  </ItemGroup>

</Project>
