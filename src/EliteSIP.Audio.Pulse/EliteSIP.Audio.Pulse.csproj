<Project Sdk="Microsoft.NET.Sdk">

  <!-- Локальный проект независимого Linux-клиента. Происхождение: core/ORIGIN.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Буферы libpulse приходят сырыми указателями, а обратные вызовы — с
      потока цикла libpulse: указатели на функции и UnmanagedCallersOnly.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PulseProbe" />
    <InternalsVisibleTo Include="EliteSIP.App.Linux" />
    <InternalsVisibleTo Include="EliteSIP.Audio.Pulse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Управляемый декодер MP3 для рингтона: у NAudio он системный (ACM), и на
      Linux его нет. Версия — под NAudio.Core 3.0.1 общего Audio.Signals.
    -->
    <PackageReference Include="NLayer.NAudioSupport" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\src\EliteSIP.Audio\EliteSIP.Audio.csproj" />
    <ProjectReference Include="..\..\core\src\EliteSIP.Audio.Signals\EliteSIP.Audio.Signals.csproj" />
  </ItemGroup>

</Project>
