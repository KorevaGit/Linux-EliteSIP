<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Проверки обновляльщика Linux-версии без root, systemd и сети: сценарий
    такта на временных каталогах, поддельной машине и поддельном канале;
    чтение общего каталога — на настоящих ссылках и именованных каналах.
    Сами systemd-run, loginctl и apt-get проверены на стенде (план, W-L7).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- Подчёркивание разделяет «что проверяем» и «чего ждём» — то же, что в shared/tests. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EliteSIP.Updater.Linux\EliteSIP.Updater.Linux.csproj" />
  </ItemGroup>

</Project>
