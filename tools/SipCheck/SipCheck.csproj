<Project Sdk="Microsoft.NET.Sdk">

  <!-- Самостоятельный Linux-стенд SIP и RTP с PulseAudio; исходники находятся рядом. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>EliteSIP.Tools.SipCheck</RootNamespace>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\core\src\EliteSIP.SipCore\EliteSIP.SipCore.csproj" />
    <ProjectReference Include="..\..\core\src\EliteSIP.SipCore.Udp\EliteSIP.SipCore.Udp.csproj" />
    <ProjectReference Include="..\..\core\src\EliteSIP.MediaCore\EliteSIP.MediaCore.csproj" />
    <ProjectReference Include="..\..\core\src\EliteSIP.Lines\EliteSIP.Lines.csproj" />
    <ProjectReference Include="..\..\src\EliteSIP.Audio.Pulse\EliteSIP.Audio.Pulse.csproj" />
  </ItemGroup>

</Project>
